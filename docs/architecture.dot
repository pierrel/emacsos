digraph EmacsOS {
  graph [label="EmacsOS · phone and agent paths", labelloc=t,
         fontname="DejaVu Sans", fontsize=23, bgcolor="white",
         rankdir=TB, pad=0.25, nodesep=0.5, ranksep=0.62,
         splines=ortho, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", color="#34506a",
        fillcolor="#f2f7fc", fontname="DejaVu Sans", fontsize=15,
        margin="0.19,0.14"];
  edge [fontname="DejaVu Sans", fontsize=11, color="#49647d",
        arrowsize=0.7];

  E1 [label="E1  Phone shell\nEmacs UI + deterministic commands",
      fillcolor="#e5edf5"];
  E2 [label="E2  Local chat client\n/chat + NDJSON stream"];
  E3 [label="E3  EmacsOS server\nFastAPI + serialized stream"];
  E4 [label="E4  Assist embedder\nAgentSpec + checkpointed Thread"];
  E5 [label="E5  Phone callback\nEmacsBackend / eval_elisp"];
  E6 [label="E6  Config history\napply + Git versions", fillcolor="#fff4d7"];
  E7 [label="E7  Assist Web client\nHTTPS phone API + SSE"];
  E8 [label="E8  Assist Web service\ncanonical threads + Runs", fillcolor="#f3f3f3"];
  E9 [label="E9  Model endpoint\nOpenAI-compatible HTTP", fillcolor="#f3f3f3"];

  E1 -> E2 [xlabel="local chat"];
  E2 -> E3 [xlabel="POST /chat"];
  E3 -> E4 [xlabel="build + stream turn"];
  E4 -> E5 [xlabel="phone tools / backend"];
  E5:w -> E1:w [xlabel="Emacs evaluation", constraint=false];
  E4 -> E6 [xlabel="config tools"];
  E4 -> E9 [xlabel="model calls"];
  E1 -> E7 [xlabel="shared threads"];
  E7 -> E8 [xlabel="submit / observe Runs"];
}
