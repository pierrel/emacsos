;;; test-rendering-assets.el --- Refresh-owned disposable files -*- lexical-binding: t -*-
(require 'ert)
(require 'cl-lib)
(require 'assist-web)

(defconst asset-test--block "```render\ntype: file\npath: /workspace/agent/chart.png\n```\n")
(defconst asset-test--png (base64-decode-string "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jD1sAAAAASUVORK5CYII="))

(defmacro asset-test--thread (&rest body)
  (declare (indent 0))
  `(let ((emacsos-assist-web-cache-directory (make-temp-file "asset-json-" t))
         (emacsos-assist-web--thread-safety (make-hash-table :test 'equal))
         (emacsos-assist-web--requests nil))
     (unwind-protect
         (with-temp-buffer
           (emacsos-assist-web-mode)
           (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () nil)))
             (emacsos-assist-web--render
              `((thread . ((id . "asset-thread") (description . "Assets") (status . "ready")
                           (workspace . ((repo_label . "Demo")))))
                (messages . (((id . "image") (role . "assistant") (text . ,asset-test--block) (state . "final"))))))
             ,@body))
       (delete-directory emacsos-assist-web-cache-directory t))))

(defun asset-test--reply (callback code data &optional etag content-type length)
  "Deliver an identity HTTP response through the production request callback."
  (let ((buffer (generate-new-buffer " *asset-response*")))
    (with-current-buffer buffer
      (set-buffer-multibyte nil)
      (insert (format "HTTP/1.1 %d Result\r\nContent-Type: %s\r\nETag: %s\r\nContent-Length: %d\r\n\r\n"
                      code (or content-type "application/octet-stream")
                      (or etag (concat "\"" (secure-hash 'sha256 data) "\""))
                      (or length (length data))))
      (setq-local url-http-response-status code
                  url-http-content-type (or content-type "application/octet-stream")
                  url-http-end-of-headers (copy-marker (1- (point))))
      (insert data)
      (funcall callback nil))
    buffer))

(ert-deftest asset-refresh-caches-changes-validates-actual-bytes-and-stays-local ()
  (asset-test--thread
    (let ((remote asset-test--png) calls (raw-request (symbol-function 'emacsos-assist-web--request)))
      (cl-letf (((symbol-function 'emacsos-assist-web--read-token) (lambda () "test-token"))
                ((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'url-retrieve)
                 (lambda (url callback &rest _)
                   (push (cons url (copy-tree url-request-extra-headers)) calls)
                   (let ((etag (concat "\"" (secure-hash 'sha256 remote) "\"")))
                     (if (equal (cdr (assoc "If-None-Match" url-request-extra-headers)) etag)
                         (asset-test--reply callback 304 "" etag)
                       (asset-test--reply callback 200 remote)))))
                ((symbol-function 'display-images-p) (lambda (&rest _) t))
                ((symbol-function 'create-image) (lambda (data type &rest _) (list 'image :type type :data data))))
        (let ((source (buffer-substring-no-properties (point-min) (point-max))))
          (emacsos-assist-web--refresh-assets)
          (should (= (length calls) 1))
          (should (string-match-p (regexp-quote "assets?path=%2Fworkspace%2Fagent%2Fchart.png") (caar calls)))
          (let ((file (emacsos-assist-web--asset-local-file "/workspace/agent/chart.png")))
            (should (equal (emacsos-assist-web--asset-bytes file) remote))
            (goto-char (point-min)) (search-forward "```render")
            (should (eq (car (get-text-property (match-beginning 0) 'display)) 'image))
            (let ((mtime (file-attribute-modification-time (file-attributes file))))
              (emacsos-assist-web--refresh-assets)
              (should (equal mtime (file-attribute-modification-time (file-attributes file)))))
            ;; Cache edits are disposable: their actual hash, not a saved ETag,
            ;; must cause another 200 and restore the remote bytes.
            (write-region "edited cache" nil file nil 'silent)
            (emacsos-assist-web--refresh-assets)
            (should (equal (emacsos-assist-web--asset-bytes file) remote))
            (setq remote (concat asset-test--png "changed"))
            (emacsos-assist-web--refresh-assets)
            (should (equal (emacsos-assist-web--asset-bytes file) remote)))
          (let ((count (length calls)))
            (emacsos-conversation--refresh-file-displays)
            (emacsos-assist-web--render emacsos-assist-web--snapshot)
            (should (= count (length calls))))
          (should (equal source (buffer-substring-no-properties (point-min) (point-max)))))
        (should (functionp raw-request))))))

(ert-deftest asset-missing-and-failed-downloads-keep-complete-copies ()
  (asset-test--thread
    (let ((file (emacsos-assist-web--asset-file "/workspace/agent/chart.png" t)))
      (write-region "complete" nil file nil 'silent)
      (cl-letf (((symbol-function 'emacsos-assist-web--request)
                 (lambda (_method _path _payload callback &rest _) (funcall callback nil "offline or 404"))))
        (emacsos-assist-web--refresh-assets)
        (should (equal (emacsos-assist-web--asset-bytes file) "complete")))
      (cl-letf (((symbol-function 'emacsos-assist-web--read-token) (lambda () "test-token"))
                ((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'url-retrieve)
                 (lambda (_url callback &rest _)
                   (asset-test--reply callback 200 "partial" nil nil 100))))
        (emacsos-assist-web--refresh-assets)
        (should (equal (emacsos-assist-web--asset-bytes file) "complete")))
      (should (equal (emacsos-conversation--local-file "/workspace/agent/chart.png") file)))))

(ert-deftest asset-304-rechecks-edits-and-deletion-during-request ()
  (dolist (change '(edit delete))
    (asset-test--thread
      (let ((file (emacsos-assist-web--asset-file "/workspace/agent/chart.png" t)) done headers)
        (write-region "complete" nil file nil 'silent)
        (cl-letf (((symbol-function 'emacsos-assist-web--request)
                   (lambda (_method _path _payload callback &optional extra &rest _)
                     (setq done callback headers extra))))
          (emacsos-assist-web--refresh-assets))
        (if (eq change 'edit) (write-region "changed" nil file nil 'silent) (delete-file file))
        (let ((etag (cdr (assoc "If-None-Match" headers))))
          (funcall done (list :status 304 :etag etag :data "") nil))
        (should (if (eq change 'edit) (equal (emacsos-assist-web--asset-bytes file) "changed")
                  (not (file-exists-p file))))))))

(ert-deftest asset-stale-generation-and-peer-denial-fence-download-writes ()
  (dolist (cause '(send thread refresh denial))
    (asset-test--thread
      (let (done (original-tid emacsos-assist-web--thread-id))
        (cl-letf (((symbol-function 'emacsos-assist-web--request)
                   (lambda (_method _path _payload callback &rest _) (setq done callback))))
          (emacsos-assist-web--refresh-assets))
        (let ((file (emacsos-assist-web--asset-file "/workspace/agent/chart.png")))
          (pcase cause
            ('send (cl-incf emacsos-assist-web--send-generation))
            ('thread (setq emacsos-assist-web--thread-id "different-thread"))
            ('refresh (cl-incf emacsos-assist-web--asset-generation))
            ('denial (emacsos-assist-web--canonical-denied 403)))
          (funcall done (list :status 200 :data "late bytes") nil)
          (should-not (file-exists-p file))
          (setq emacsos-assist-web--thread-id original-tid))))))

(ert-deftest asset-namespaces-paths-bounds-and-workspace-precedence ()
  (asset-test--thread
    (let* ((root (make-temp-file "asset-workspace-" t))
           (workspace-file (expand-file-name "agent/chart.png" root)) calls)
      (unwind-protect
          (progn
            (make-directory (file-name-directory workspace-file))
            (write-region "editable" nil workspace-file nil 'silent)
            (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () root))
                      ((symbol-function 'emacsos-assist-web--request) (lambda (&rest _) (cl-incf calls))))
              (emacsos-assist-web--refresh-assets)
              (should-not calls)
              (should (equal (emacsos-conversation--local-file "/workspace/agent/chart.png") workspace-file))
              (should (equal (with-temp-buffer (insert-file-contents workspace-file) (buffer-string)) "editable")))
            (let ((work (emacsos-assist-web--asset-file "/workspace/a.png" t))
                  (user (emacsos-assist-web--asset-file "/user/a.png"))
                  (scratch (emacsos-assist-web--asset-file "/tmp/a.png")))
              (should (= (length (delete-dups (list work user scratch))) 3))
              (let ((emacsos-assist-web--thread-id "another-thread"))
                (should-not (equal work (emacsos-assist-web--asset-file "/workspace/a.png"))))
              (dolist (path '("/etc/passwd" "/tmp/../secret" ".git/config" "/workspace/.GIT/config" "/ssh:host:/x"))
                (should-not (emacsos-assist-web--asset-file path)))
              (write-region (make-string (1+ emacsos-assist-web--asset-max-bytes) ?x) nil work nil 'silent)
              (should-not (emacsos-assist-web--asset-bytes work))
              (delete-file work)
              (make-symbolic-link workspace-file work)
              (should-not (emacsos-assist-web--asset-bytes work))))
        (delete-directory root t)))))

(ert-deftest asset-errors-classify-authentication-separately-from-missing-file ()
  (asset-test--thread
    (emacsos-assist-web--http-access-status (current-buffer) "GET" "threads/asset-thread/assets?path=x" 404)
    (should-not emacsos-assist-web--denied)
    (emacsos-assist-web--http-access-status (current-buffer) "GET" "threads/asset-thread/assets?path=x" 401)
    (should emacsos-assist-web--denied)))

(ert-deftest asset-explicit-refresh-consumes-intent-and-only-then-fetches ()
  (asset-test--thread
    (let ((snapshot (copy-tree emacsos-assist-web--snapshot)) calls)
      (cl-letf (((symbol-function 'emacsos-assist-web--read-token) (lambda () "test-token"))
                ((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'emacsos-assist-web-git-refresh) #'ignore)
                ((symbol-function 'url-retrieve)
                 (lambda (url callback &rest _)
                   ;; Count file/snapshot GETs; the settled view also sends a read receipt.
                   (when (equal url-request-method "GET") (push url calls))
                   (if (string-match-p (regexp-quote "/assets?") url)
                       (asset-test--reply callback 200 asset-test--png)
                     (asset-test--reply callback 200 (json-encode snapshot) nil "application/json")))))
        (goto-char (point-max)) (insert "unsent draft")
        (emacsos-assist-web-refresh-context)
        (should (= (length calls) 2))
        (should-not emacsos-assist-web--asset-refresh-pending)
        (should (equal (emacsos-assist-web--input) "unsent draft"))
        (emacsos-assist-web--render snapshot)
        (should (= (length calls) 2))
        (emacsos-assist-web-refresh-thread)
        (should (= (length calls) 3))
        (should-not (string-match-p (regexp-quote "/assets?") (car calls)))))))

(ert-deftest asset-refresh-failure-does-not-leak-intent-into-automatic-read ()
  (asset-test--thread
    (let ((snapshot (copy-tree emacsos-assist-web--snapshot)) (bad t) calls)
      (cl-letf (((symbol-function 'emacsos-assist-web--read-token) (lambda () "test-token"))
                ((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'emacsos-assist-web-git-refresh) #'ignore)
                ((symbol-function 'url-retrieve)
                 (lambda (url callback &rest _)
                   ;; Count file/snapshot GETs; the settled view also sends a read receipt.
                   (when (equal url-request-method "GET") (push url calls))
                   (asset-test--reply callback 200 (if bad "invalid" (json-encode snapshot)) nil "application/json"))))
        (emacsos-assist-web-refresh-context)
        (should-not emacsos-assist-web--asset-refresh-pending)
        (setq bad nil)
        (emacsos-assist-web-refresh-thread)
        (should (= (length calls) 2))
        (should-not (seq-some (lambda (url) (string-match-p (regexp-quote "/assets?") url)) calls))))))

(ert-deftest asset-raw-parser-accepts-full-body-and-rejects-mismatched-validator ()
  (let ((body (make-string emacsos-assist-web--asset-max-bytes ?x)) value)
    (asset-test--reply (lambda (_) (setq value (emacsos-assist-web--asset-response (current-buffer)))) 200 body)
    (should (= (length (plist-get value :data)) emacsos-assist-web--asset-max-bytes))
    (should-error (asset-test--reply (lambda (_) (emacsos-assist-web--asset-response (current-buffer)))
                                   200 "bad" (concat "\"" (make-string 64 ?0) "\"")))))

(ert-deftest asset-cache-fifo-is-never-read-or-presented ()
  (skip-unless (executable-find "mkfifo"))
  (asset-test--thread
    (let ((file (emacsos-assist-web--asset-file "/workspace/agent/chart.png" t)))
      (should (= (call-process "mkfifo" nil nil nil file) 0))
      (should-not (emacsos-assist-web--asset-bytes file))
      (should-not (emacsos-assist-web--asset-local-file "/workspace/agent/chart.png")))))

(ert-deftest asset-reference-count-prunes-private-cache-and-excludes-maps ()
  (asset-test--thread
    (let ((snapshot (copy-tree emacsos-assist-web--snapshot)) calls)
      (setf (alist-get 'text (car (alist-get 'messages snapshot)))
            (concat (mapconcat (lambda (index) (format "```render\ntype: file\npath: /tmp/%d.png\n```\n" index))
                               (number-sequence 0 19) "")
                    "```render\ntype: map\npath: /tmp/map.png\n```\n"))
      (emacsos-assist-web--render snapshot)
      (cl-letf (((symbol-function 'emacsos-assist-web--request)
                 (lambda (_method path _payload callback &rest _)
                   (push path calls)
                   (funcall callback (list :status 200 :data "sample") nil))))
        (emacsos-assist-web--refresh-assets)
        (should (= (length calls) 16))
        (should-not (seq-some (lambda (path) (string-match-p "map.png" path)) calls))
        (should (= (length (directory-files emacsos-assist-web--asset-directory nil "^[0-9a-f]")) 16))
        (setf (alist-get 'text (car (alist-get 'messages snapshot))) asset-test--block)
        (emacsos-assist-web--render snapshot)
        (emacsos-assist-web--refresh-assets)
        (should (= (length (directory-files emacsos-assist-web--asset-directory nil "^[0-9a-f]")) 1))))))

(ert-deftest asset-cache-directory-symlink-never-prunes-an-outside-file ()
  (asset-test--thread
    (let* ((name (emacsos-assist-web--asset-file "/workspace/agent/chart.png" t))
           (original emacsos-assist-web--asset-directory)
           (outside (make-temp-file "asset-outside-" t))
           (sentinel (expand-file-name (file-name-nondirectory name) outside)))
      (unwind-protect
          (progn
            (write-region "outside" nil sentinel nil 'silent)
            (delete-directory original)
            (make-symbolic-link outside original)
            (cl-letf (((symbol-function 'emacsos-assist-web--request)
                       (lambda (_method _path _payload callback &rest _) (funcall callback nil "cache unavailable"))))
              (emacsos-assist-web--refresh-assets))
            (should (equal (with-temp-buffer (insert-file-contents sentinel) (buffer-string)) "outside")))
        (delete-file original)
        (delete-directory outside t)))))

(ert-deftest asset-http-envelope-allows-full-body-with-a-separate-header-budget ()
  (let (filter forwarded failed)
    (let ((emacsos-assist-web-max-response-bytes (+ emacsos-assist-web--asset-max-bytes emacsos-assist-web-max-header-bytes)))
      (setq filter (emacsos-assist-web--guarded-filter
                    (lambda (_process bytes) (setq forwarded (length bytes)))
                    (lambda (_process error) (setq failed error)))))
    (funcall filter nil (concat "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\n\r\n"
                               (make-string emacsos-assist-web--asset-max-bytes ?x)))
    (should-not failed)
    (should (> forwarded emacsos-assist-web--asset-max-bytes))))

(ert-deftest asset-rejected-canonical-snapshot-never-starts-downloads ()
  (asset-test--thread
    (let ((snapshot (copy-tree emacsos-assist-web--snapshot)) calls)
      (setf (alist-get 'id (alist-get 'thread snapshot)) "different-thread")
      (cl-letf (((symbol-function 'emacsos-assist-web--read-token) (lambda () "test-token"))
                ((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'emacsos-assist-web-git-refresh) #'ignore)
                ((symbol-function 'url-retrieve)
                 (lambda (url callback &rest _)
                   (push url calls)
                   (asset-test--reply callback 200 (json-encode snapshot) nil "application/json"))))
        (emacsos-assist-web-refresh-context)
        (should (= (length calls) 1))
        (should-not emacsos-assist-web--asset-directory)
        (should-not emacsos-assist-web--asset-refresh-pending)))))

(ert-deftest asset-stale-canonical-refresh-never-starts-downloads ()
  (asset-test--thread
    (let ((snapshot (copy-tree emacsos-assist-web--snapshot)) done calls)
      (cl-letf (((symbol-function 'emacsos-assist-web--read-token) (lambda () "test-token"))
                ((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'emacsos-assist-web-git-refresh) #'ignore)
                ((symbol-function 'url-retrieve)
                 (lambda (url callback &rest _) (push url calls) (setq done callback) nil)))
        (emacsos-assist-web-refresh-context)
        (cl-incf emacsos-assist-web--refresh-generation)
        (asset-test--reply done 200 (json-encode snapshot) nil "application/json")
        (should (= (length calls) 1))
        (should-not emacsos-assist-web--asset-directory)))))

(ert-deftest asset-deleted-directory-is-rebuilt-on-next-refresh ()
  (asset-test--thread
    (let* ((first (emacsos-assist-web--asset-file "/workspace/agent/chart.png" t))
           (directory emacsos-assist-web--asset-directory))
      (write-region "old" nil first nil 'silent)
      (delete-directory directory t)
      (cl-letf (((symbol-function 'emacsos-assist-web--request)
                 (lambda (_method _path _payload callback &rest _)
                   (funcall callback (list :status 200 :data "new") nil))))
        (emacsos-assist-web--refresh-assets))
      (should-not (equal directory emacsos-assist-web--asset-directory))
      (should (equal (emacsos-assist-web--asset-bytes
                      (emacsos-assist-web--asset-local-file "/workspace/agent/chart.png")) "new")))))

(ert-deftest asset-text-reopen-after-refresh-is-read-only-and-never-prompts ()
  (asset-test--thread
    (let* ((thread (current-buffer)) (path "/workspace/report.txt")
           (file (emacsos-assist-web--asset-file path t)) view)
      (unwind-protect
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) (ert-fail "Modal cache question")))
                    ((symbol-function 'y-or-n-p) (lambda (&rest _) (ert-fail "Modal cache question"))))
            (dolist (text '("café ½" "更新 ✓"))
              (with-current-buffer thread
                (write-region text nil file nil 'silent)
                (let ((inhibit-read-only t))
                  (erase-buffer)
                  (insert (propertize "file" 'emacsos-conversation-object `(file ,path nil))))
                (goto-char (point-min))
                (emacsos-conversation--open-object)
                (setq view (window-buffer (selected-window))))
              (with-current-buffer view
                (should buffer-read-only)
                (should-not buffer-file-name)
                (should (equal (buffer-string) text))))
            (should-not (find-buffer-visiting file)))
        (when (buffer-live-p view) (kill-buffer view))))))

(ert-deftest asset-canonical-redraw-bounds-tiny-invalid-image-attempts ()
  (asset-test--thread
    (let ((root (make-temp-file "invalid-assets-" t)) (reads 0)
          (reader (symbol-function 'insert-file-contents-literally))
          (snapshot (copy-tree emacsos-assist-web--snapshot)) messages)
      (unwind-protect
          (progn
            (dotimes (index 20)
              (write-region "invalid" nil (expand-file-name (format "bad%d.png" index) root) nil 'silent)
              (push `((id . ,(format "bad%d" index)) (role . "assistant") (state . "final")
                      (text . ,(format "```render\ntype: file\npath: bad%d.png\n```\n" index))) messages))
            (setf (alist-get 'messages snapshot) (nreverse messages))
            (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () root))
                      ((symbol-function 'display-images-p) (lambda (&rest _) t))
                      ((symbol-function 'insert-file-contents-literally)
                       (lambda (&rest args) (cl-incf reads) (apply reader args))))
              (emacsos-assist-web--render snapshot))
            (should (= reads 16)))
        (delete-directory root t)))))

(provide 'test-rendering-assets)
