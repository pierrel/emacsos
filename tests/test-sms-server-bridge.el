;;; -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'phone-sms)
(require 'assist-web)
(load-file (expand-file-name "../deploy/pinephone/openrc-init.el" (file-name-directory load-file-name)))

(ert-deftest sms-server-draft-reuses-physical-gate-and-stable-attempt ()
  (let* ((identity (concat "outbox_" (make-string 64 ?a)))
         (emacsos-assist-web--thread-id "synthetic-thread")
         (emacsos-assist-web--approval `((kind . "send_sms") (id . ,identity) (number . "+15555550100") (text . "hey now") (token . ,(make-string 64 ?b)) (state . "pending")))
         (emacsos-sms--state nil) (emacsos-sms--context nil)
         (emacsos-sms--rejecting nil) (emacsos-sms--proposal-id nil)
         (emacsos-sms--confirm-id nil) (emacsos-sms--confirm-timer nil)
         (emacsos-sms-operation-function #'emacsos-pinephone-sms-operation)
         sends decisions observed)
    (cl-letf (((symbol-function 'emacsos-assist-web--sms-journal)
               (lambda (_id callback) (funcall callback `((message . ,observed)) nil)))
              ((symbol-function 'emacsos-sms--show) (lambda () t))
              ((symbol-function 'emacsos-sms--visible-p) (lambda () t))
              ((symbol-function 'emacsos-assist-web--sms-decision)
               (lambda (context decision callback)
                 (push decision decisions)
                 (funcall callback `((id . ,identity) (number . "+15555550100") (text . "hey now") (state . ,(if (equal decision "approve") "approved" decision))) nil)))
              ((symbol-function 'emacsos-pinephone-sms-operation-local)
               (lambda (number body callback &optional message-id)
                 (push (list number body message-id) sends)
                 (funcall callback "sent") "pending: SMS requested")))
      (emacsos-assist-web--review-sms)
      (should (eq emacsos-sms--state 'proposed))
      (should-not sends) (should-not decisions)
      (emacsos-sms--send-tap)
      (should-not sends)
      (emacsos-sms--send-tap)
      (should (equal sends `(("+15555550100" "hey now" ,identity))))
      (should (eq emacsos-sms--state 'sent))
      (should (member "approve" decisions))
      ;; Lost result POST followed by restart reads existing journal outcome;
      ;; it does not expose a fresh actionable send or create a new identity.
      (setq emacsos-sms--state nil emacsos-sms--context nil
            observed `((id . ,identity) (number . "+15555550100") (text . "hey now") (status . "sent")))
      (emacsos-assist-web--review-sms)
      (should (eq emacsos-sms--state 'sent))
      (should (= (length sends) 1)))))

(ert-deftest sms-server-reject-requires-ack-before-clearing ()
  (let ((emacsos-sms--state 'proposed)
        (emacsos-sms--context "assist-sms:server")
        (emacsos-sms--rejecting nil) callback dismissed)
    (let ((emacsos-sms-discard-function (lambda (_context fn) (setq callback fn))))
      (cl-letf (((symbol-function 'emacsos-sms--dismiss) (lambda () (setq dismissed t)))
                ((symbol-function 'emacsos-sms--clear-confirm) #'ignore))
        (emacsos-sms--cancel)
        (should emacsos-sms--rejecting) (should-not dismissed)
        (funcall callback nil)
        (should-not dismissed)
        (funcall callback t)
        (should dismissed)))))

(ert-deftest sms-server-failed-approval-can-be-reviewed-again-with-same-attempt ()
  (let* ((identity (concat "outbox_" (make-string 64 ?c)))
         (emacsos-assist-web--thread-id "synthetic-thread")
         (emacsos-assist-web--approval
          `((kind . "send_sms") (id . ,identity) (number . "+15555550100")
            (text . "hey now") (token . ,(make-string 64 ?d)) (state . "pending")))
         (emacsos-sms--state nil) (emacsos-sms--context nil)
         (emacsos-sms--rejecting nil) (emacsos-sms--confirm-id nil)
         (emacsos-sms--confirm-timer nil))
    (cl-letf (((symbol-function 'emacsos-assist-web--sms-journal)
               (lambda (_identity callback) (funcall callback '((message)) nil)))
              ((symbol-function 'emacsos-sms--show) (lambda () t)))
      (emacsos-assist-web--review-sms)
      (let ((context emacsos-sms--context))
        (setq emacsos-sms--state 'failed)
        (emacsos-assist-web--review-sms)
        (should (eq emacsos-sms--state 'proposed))
        (should (equal context emacsos-sms--context))
        (should-not emacsos-sms--confirm-id)))))

(ert-deftest sms-server-approved-without-journal-can-reject-but-attempt-cannot ()
  (let* ((encoded (concat "assist-sms:" (json-encode '((id . "outbox_test")))))
         observed rejected acknowledged)
    (cl-letf (((symbol-function 'emacsos-assist-web--sms-journal)
               (lambda (_identity callback) (funcall callback `((message . ,observed)) nil)))
              ((symbol-function 'emacsos-assist-web--sms-decision)
               (lambda (_context decision callback)
                 (setq rejected decision)
                 (funcall callback '((state . "rejected")) nil))))
      (emacsos-assist-web--sms-discard encoded (lambda (value) (setq acknowledged value)))
      (should acknowledged) (should (equal rejected "reject"))
      (setq observed '((status . "unknown")) rejected nil acknowledged nil)
      (emacsos-assist-web--sms-discard encoded (lambda (value) (setq acknowledged value)))
      (should-not acknowledged) (should-not rejected))))

(ert-deftest sms-server-late-approval-cannot-send-after-owner-loss-and-rejection ()
  (let* ((context '((id . "outbox_test") (number . "+15555550100") (text . "hey now")))
         (emacsos-sms--context (concat "assist-sms:" (json-encode context)))
         (emacsos-sms--proposal-id "old-physical-confirmation")
         (emacsos-sms--state 'sending)
         (emacsos-sms-lifecycle-functions nil)
         approve sent)
    (cl-letf (((symbol-function 'emacsos-assist-web--sms-decision)
               (lambda (_context _decision callback) (setq approve callback)))
              ((symbol-function 'emacsos-sms--visible-p) (lambda () t))
              ((symbol-function 'emacsos-sms--show) (lambda () t))
              ((symbol-function 'emacsos-sms--rerender) #'ignore)
              ((symbol-function 'emacsos-pinephone-sms-operation-local)
               (lambda (&rest _) (setq sent t))))
      (emacsos-pinephone-sms-operation "+15555550100" "hey now" #'ignore)
      (should approve) (should-not sent)
      (emacsos-sms--on-owner-changed ":1.old" ":1.new" 4)
      (should (eq emacsos-sms--state 'unknown))
      (emacsos-sms-acknowledge)
      ;; The old physical confirmation no longer owns a sending proposal,
      ;; even if the same server draft was reopened and rejected meanwhile.
      (funcall approve '((state . "approved")) nil)
      (should-not sent))))
