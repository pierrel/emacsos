;;; test-assist-web-send-draft.el --- Ordinary HTTP draft contract -*- lexical-binding: t -*-
(require 'ert)
(require 'assist-web)
(defvar test-send-draft--unexpected-requests nil)

(defmacro test-send-draft--with-thread (&rest body)
  `(let ((test-send-draft--unexpected-requests nil)
         (emacsos-assist-web-cache-directory (make-temp-file "send-draft-" t))
         (emacsos-assist-web--thread-safety (make-hash-table :test #'equal)))
     (unwind-protect
         (with-temp-buffer
           (emacsos-assist-web-mode)
           (setq emacsos-assist-web--thread-id "draft-thread")
           (emacsos-assist-web--write-prompt)
           ,@body
           (should-not test-send-draft--unexpected-requests))
       (delete-directory emacsos-assist-web-cache-directory t))))

(ert-deftest test-send-draft-busy-post-keeps-existing-observer-and-accepts-server-work ()
  (test-send-draft--with-thread
   (setq emacsos-assist-web--in-flight t emacsos-assist-web--run-id "existing-run")
   (emacsos-assist-web--replace-input "Unicode café — 🐟\nnext line")
   (let (posted)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (method path payload callback &rest _)
                  (setq posted (list method path payload))
                  (funcall callback '((thread_id . "draft-thread")
                                      (run_id . "server-pending") (status . "pending")) nil)))
               ((symbol-function 'emacsos-assist-web--observe-run)
                (lambda (&rest _) (push "Existing response must continue" test-send-draft--unexpected-requests))))
       (call-interactively #'emacsos-assist-web-send))
     (should (equal posted '("POST" "threads/draft-thread/messages"
                            ((message . "Unicode café — 🐟\nnext line")))))
     (should (equal emacsos-assist-web--run-id "existing-run"))
     (should emacsos-assist-web--in-flight)
     (should-not emacsos-assist-web--http-draft)
     (should (equal (emacsos-assist-web--input) "")))))

(ert-deftest test-send-draft-failure-save-reopen-and-retry-preserve-unicode-and-key ()
  (test-send-draft--with-thread
   (emacsos-assist-web--replace-input "exact café — 🐟\nnext line")
   (let (original-key)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method _path _payload callback headers &rest _)
                  (setq original-key (cdr (assoc "Idempotency-Key" headers)))
                  (funcall callback nil "timeout"))))
       (call-interactively #'emacsos-assist-web-send))
     (should (equal (emacsos-assist-web--input) "exact café — 🐟\nnext line"))
     (call-interactively (lookup-key emacsos-assist-web-mode-map (kbd "C-x C-s")))
     (with-temp-buffer
       (emacsos-assist-web-mode)
       (setq emacsos-assist-web--thread-id "draft-thread")
       (emacsos-assist-web--write-prompt)
       (cl-letf (((symbol-function 'emacsos-assist-web--request)
                  (lambda (&rest _) (push "Reopen must not submit" test-send-draft--unexpected-requests))))
         (emacsos-assist-web--restore-draft))
       (should (equal (emacsos-assist-web--input) "exact café — 🐟\nnext line"))
       (let (retry-key)
         (cl-letf (((symbol-function 'emacsos-assist-web--request)
                    (lambda (_method _path _payload callback headers &rest _)
                      (setq retry-key (cdr (assoc "Idempotency-Key" headers)))
                      (funcall callback nil "offline"))))
           (call-interactively #'emacsos-assist-web-send))
         (should (equal retry-key original-key)))))))

(ert-deftest test-send-draft-edited-retry-uses-new-key-without-an-acknowledgment-gate ()
  (test-send-draft--with-thread
   (emacsos-assist-web--replace-input "original")
   (let (keys)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method _path _payload callback headers &rest _)
                  (push (cdr (assoc "Idempotency-Key" headers)) keys)
                  (funcall callback nil "timeout"))))
       (call-interactively #'emacsos-assist-web-send)
       (emacsos-assist-web--replace-input "edited")
       (call-interactively #'emacsos-assist-web-send))
     (should (= (length keys) 2))
     (should-not (equal (car keys) (cadr keys)))
     (should (equal (emacsos-assist-web--input) "edited")))))

(ert-deftest test-send-draft-reopen-preserves-intentionally-empty-editable-text ()
  (test-send-draft--with-thread
   (setq emacsos-assist-web--http-draft
         '(:key "emacsos-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" :text "previous failed text"))
   (emacsos-assist-web--replace-input "")
   (call-interactively #'emacsos-assist-web-save-draft)
   (emacsos-assist-web--restore-draft)
   (should (equal (emacsos-assist-web--input) ""))
   (should (equal (plist-get emacsos-assist-web--http-draft :text) "previous failed text"))))

(ert-deftest test-send-draft-legacy-import-keeps-unsent-text-and-uncertain-key-only ()
  (test-send-draft--with-thread
   (should (emacsos-assist-web--try-write-cache
            (emacsos-assist-web--draft-cache-name)
            '((text . "editable tail") (recovery_draft . "source draft")
              (queue . (((state . "accepted-unobserved") (text . "accepted never requeue"))
                        ((state . "acceptance-unknown") (text . "uncertain text")
                         (key . "emacsos-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
                        ((state . "queued") (text . "waiting text")))))))
   (emacsos-assist-web--restore-draft)
   (should (equal (emacsos-assist-web--input)
                  "uncertain text\n\nwaiting text\n\nsource draft\n\neditable tail"))
   (should (equal (plist-get emacsos-assist-web--http-draft :key)
                  "emacsos-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
   (call-interactively #'emacsos-assist-web-save-draft)
   (let ((saved (emacsos-assist-web--read-cache (emacsos-assist-web--draft-cache-name))))
     (should-not (assq 'queue saved))
     (should-not (assq 'run_id saved)))))

(ert-deftest test-send-draft-legacy-accepted-text-is-not-an-unsent-draft ()
