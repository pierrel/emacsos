(ert-deftest test-send-draft-r1-created-thread-already-open-preserves-both-drafts ()
  (dolist (save-fails '(nil t))
    (test-send-draft--with-thread
     (setq emacsos-assist-web--thread-id nil emacsos-assist-web--draft-id "local-create")
     (emacsos-assist-web--replace-input "submitted")
     (let ((source (current-buffer)) (destination (generate-new-buffer " *existing-created*")) callback before old)
       (unwind-protect
           (progn
             (with-current-buffer destination
               (emacsos-assist-web-mode)
               (setq emacsos-assist-web--thread-id "already-created"
                     emacsos-assist-web--in-flight t emacsos-assist-web--run-id "another-run")
               (emacsos-assist-web--write-prompt)
               (emacsos-assist-web--replace-input "independent canonical draft")
               (emacsos-assist-web--save-draft)
               (setq before (emacsos-assist-web--read-cache (emacsos-assist-web--draft-cache-name))))
             (cl-letf (((symbol-function 'emacsos-assist-web--request)
                        (lambda (_m _p _v cb &rest _) (setq callback cb)))
                       ((symbol-function 'display-buffer) #'ignore))
               (call-interactively #'emacsos-assist-web-send)
               (setq old emacsos-assist-web--http-draft)
               (goto-char (point-max)) (insert " unsent tail")
               (if save-fails
                   (cl-letf (((symbol-function 'emacsos-assist-web--save-draft) (lambda (&rest _) nil)))
                     (funcall callback '((thread_id . "already-created") (run_id . "accepted-run")) nil))
                 (funcall callback '((thread_id . "already-created") (run_id . "accepted-run")) nil)))
             (should (eq (current-buffer) source))
             (should-not emacsos-assist-web--thread-id)
             (should (equal emacsos-assist-web--draft-id "local-create"))
             (should (equal (emacsos-assist-web--input) (if save-fails "submitted unsent tail" " unsent tail")))
             (should (if save-fails (eq old emacsos-assist-web--http-draft) (null emacsos-assist-web--http-draft)))
             (with-current-buffer destination
               (should (equal (emacsos-assist-web--input) "independent canonical draft"))
               (should (equal emacsos-assist-web--run-id "another-run"))
               (should emacsos-assist-web--in-flight)
               (should (equal before (emacsos-assist-web--read-cache (emacsos-assist-web--draft-cache-name))))))
         (kill-buffer destination))))))

(ert-deftest test-send-draft-r1-observer-publishes-active-surface-before-transport ()
  (let ((buffer (generate-new-buffer " *admitted-observer*")) seen)
    (unwind-protect
        (with-current-buffer buffer
          (emacsos-assist-web-mode)
          (setq emacsos-assist-web--thread-id "observed-thread" emacsos-assist-web--run-id "observed-run"
                emacsos-assist-web--in-flight t)
          (let ((emacsos--assist-active-surface nil))
            (cl-letf (((symbol-function 'emacsos-assist-web--read-token) (lambda () "synthetic-token"))
                      ((symbol-function 'emacsos-assist-web--close-idle-origin-connections) #'ignore)
                      ((symbol-function 'url-retrieve)
                       (lambda (&rest _) (setq seen emacsos--assist-active-surface) nil)))
              (emacsos-assist-web--observe-run buffer))
            (should (eq seen 'web))
            (should-not emacsos--assist-active-surface)))
      (kill-buffer buffer))))

(ert-deftest test-send-draft-r2-identical-unsent-suffix-survives-transcript-and-reopen ()
  (test-send-draft--with-thread
   (emacsos-assist-web--replace-input "x")
   (let (callback)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_m _p _v cb &rest _) (setq callback cb)))
               ((symbol-function 'emacsos-assist-web--observe-run) #'ignore))
       (call-interactively #'emacsos-assist-web-send)
       (goto-char (point-max)) (insert "x")
       (funcall callback '((thread_id . "draft-thread") (run_id . "accepted-run")) nil))
     (should (equal (emacsos-assist-web--input) "x"))
     (call-interactively #'emacsos-assist-web-save-draft)
     (emacsos-assist-web--replace-input "")
     (emacsos-assist-web--restore-draft)
     (should (equal (emacsos-assist-web--input) "x")))))

(ert-deftest test-send-draft-r2-deleted-thread-rejects-late-canonical-snapshot ()
  (test-send-draft--with-thread
   (emacsos-assist-web--append-pending "accepted message")
   (emacsos-assist-web--reset-assistant 1)
   (emacsos-assist-web--append-delta 1 1 "retained partial")
   (emacsos-assist-web--replace-input "editable retained draft")
   (let (callback before)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_m _p _v cb &rest _) (setq callback cb))))
       (emacsos-assist-web-refresh-thread))
     (emacsos-assist-web--thread-gone (current-buffer))
     (setq before (buffer-string))
     (funcall callback '((thread . ((id . "draft-thread") (description . "Deleted old view")
                                   (status . "ready") (workspace . ((repo_label . "Synthetic")))))
                         (messages . nil)) nil)
     (should-not emacsos-assist-web--thread-id)
     (should (equal (buffer-string) before))
     (should (equal (emacsos-assist-web--input) "editable retained draft")))))

(ert-deftest test-send-draft-r2-local-chat-started-during-http-defers-web-observer ()
  (test-send-draft--with-thread
   (emacsos-assist-web--replace-input "accepted by server")
   (let ((emacsos--assist-active-surface nil) callback requests)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_m _p _v cb &rest _) (setq callback cb)))
               ((symbol-function 'emacsos-assist-web--read-token) (lambda () "synthetic-token"))
               ((symbol-function 'emacsos-assist-web--close-idle-origin-connections) #'ignore)
               ((symbol-function 'url-retrieve)
                (lambda (&rest args) (push args requests) nil)))
       (call-interactively #'emacsos-assist-web-send)
       (setq emacsos--assist-active-surface 'chat)
       (funcall callback '((thread_id . "draft-thread") (run_id . "accepted-run")) nil))
     (should-not requests)
     (should (eq emacsos--assist-active-surface 'chat))
     (should-not emacsos-assist-web--in-flight)
     (should emacsos-assist-web--pending-accepted-p)
     (should (equal emacsos-assist-web--run-id "accepted-run")))))
