(ert-deftest test-send-draft-post-pending-and-observer-completion-are-independent ()
  (test-send-draft--with-thread
   (emacsos-assist-web--replace-input "submitted text")
   (let (callback (posts 0))
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method _path _payload response &rest _)
                  (cl-incf posts) (setq callback response))))
       (call-interactively #'emacsos-assist-web-send)
       (call-interactively #'emacsos-assist-web-send)
       (should (= posts 1))
       (let ((pending emacsos-assist-web--http-draft))
         (emacsos-assist-web--stream-cleanup t t)
         (should (eq pending emacsos-assist-web--http-draft)))
       (emacsos-assist-web--replace-input "newly typed tail")
       (funcall callback nil "offline"))
     (should (equal (emacsos-assist-web--input) "submitted text\n\nnewly typed tail")))))

