(ert-deftest test-send-draft-new-thread-saves-typed-tail-in-canonical-cache ()
  (test-send-draft--with-thread
   (setq emacsos-assist-web--thread-id nil emacsos-assist-web--draft-id "new-thread"
         emacsos-assist-web--draft-repository "repo" emacsos-assist-web--draft-harness "deepagents")
   (emacsos-assist-web--replace-input "first message")
   (let (callback)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method path _payload response &rest _)
                  (unless (equal path "threads") (push path test-send-draft--unexpected-requests)) (setq callback response)))
               ((symbol-function 'emacsos-assist-web--observe-run) #'ignore))
       (call-interactively #'emacsos-assist-web-send)
       (emacsos-assist-web--replace-input "next editable text")
       (funcall callback '((thread_id . "created-thread") (run_id . "created-run")) nil))
     (should (equal emacsos-assist-web--thread-id "created-thread"))
     (should-not emacsos-assist-web--http-draft)
     (should (equal (emacsos-assist-web--input) "next editable text"))
     (let ((saved (emacsos-assist-web--read-cache "drafts/created-thread.json")))
       (should (equal (alist-get 'text saved) "next editable text"))
       (should-not (alist-get 'run_id saved)))
     (should-not (emacsos-assist-web--read-cache "drafts/new-thread.json")))))

(ert-deftest test-send-draft-server-rejection-is-a-clear-http-error-not-an-accepted-run ()
  (test-send-draft--with-thread
   (emacsos-assist-web--replace-input "retry after busy limit")
   (cl-letf (((symbol-function 'emacsos-assist-web--request)
              (lambda (_method _path _payload callback _headers allow-status &rest _)
                (should allow-status)
                (funcall callback '((http_status . 429) (detail . "pending run limit reached")) nil))))
     (call-interactively #'emacsos-assist-web-send))
   (should (equal (emacsos-assist-web--input) "retry after busy limit"))
   (should (string-match-p "HTTP 429" emacsos-assist-web--stream-status))
   (should-not emacsos-assist-web--run-id)))

(ert-deftest test-send-draft-late-post-for-deleted-thread-keeps-new-target-untouched ()
  (test-send-draft--with-thread
   (emacsos-assist-web--append-pending "observed message")
   (emacsos-assist-web--reset-assistant 1)
   (emacsos-assist-web--append-delta 1 1 "visible partial answer")
   (setq emacsos-assist-web--run-id "observed-run" emacsos-assist-web--in-flight t)
   (emacsos-assist-web--replace-input "old target text")
   (let (callback)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method _path _payload response &rest _) (setq callback response))))
       (call-interactively #'emacsos-assist-web-send)
       (emacsos-assist-web--thread-gone (current-buffer))
       (emacsos-assist-web--replace-input "new target draft")
       (call-interactively #'emacsos-assist-web-save-draft)
       (let ((before (emacsos-assist-web--read-cache (emacsos-assist-web--draft-cache-name))))
         (funcall callback '((thread_id . "draft-thread") (run_id . "old-target-run")) nil)
         (should (equal (emacsos-assist-web--input) "new target draft"))
         (should (string-match-p "visible partial answer" (buffer-string)))
         (should-not emacsos-assist-web--thread-id)
         (should-not emacsos-assist-web--run-id)
         (should-not (plist-get emacsos-assist-web--http-draft :posting))
         (should (equal (emacsos-assist-web--read-cache
                         (emacsos-assist-web--draft-cache-name)) before)))))))

(ert-deftest test-send-draft-observed-run-get-rejects-another-run-before-history ()
  (test-send-draft--with-thread
   (setq emacsos-assist-web--run-id "expected-run" emacsos-assist-web--pending-accepted-p t)
   (let (canonical-read)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method path _payload callback &rest _)
                  (unless (equal path "threads/draft-thread/runs/expected-run") (push path test-send-draft--unexpected-requests))
                  (funcall callback '((thread_id . "draft-thread") (id . "other-run")
                                      (status . "success")) nil)))
               ((symbol-function 'emacsos-assist-web-refresh-thread)
                (lambda (&rest _) (setq canonical-read t))))
       (emacsos-assist-web--refresh-observed-run (current-buffer)))
     (should-not canonical-read)
     (should (equal emacsos-assist-web--run-id "expected-run")))))

(ert-deftest test-send-draft-observer-budget-and-token-error-do-not-start-network ()
  (dolist (token-error '(nil t))
    (test-send-draft--with-thread
     (setq emacsos-assist-web--in-flight t emacsos-assist-web--run-id "observed-run")
     (let ((emacsos-assist-web--requests (unless token-error '(one two three four))))
       (cl-letf (((symbol-function 'emacsos-assist-web--read-token)
                  (lambda () (if token-error (error "token read unavailable") "synthetic-token")))
                 ((symbol-function 'url-retrieve)
                  (lambda (&rest _) (push "Unavailable observer must not connect" test-send-draft--unexpected-requests))))
         (emacsos-assist-web--observe-run (current-buffer)))
       (should-not emacsos-assist-web--in-flight)))))

(ert-deftest test-send-draft-old-refresh-cannot-replace-a-newer-accepted-send ()
  (test-send-draft--with-thread
   (let (get-callback post-callback rendered)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (method _path _payload callback &rest _)
                  (if (equal method "GET") (setq get-callback callback)
                    (setq post-callback callback))))
               ((symbol-function 'emacsos-assist-web--observe-run) #'ignore)
               ((symbol-function 'emacsos-assist-web--render)
                (lambda (&rest _) (setq rendered t))))
       (emacsos-assist-web-refresh-thread)
       (emacsos-assist-web--replace-input "new accepted text")
       (call-interactively #'emacsos-assist-web-send)
       (funcall post-callback '((thread_id . "draft-thread") (run_id . "new-run")) nil)
       (funcall get-callback '((thread . ((id . "draft-thread") (description . "Old")
                                          (status . "ready") (workspace . ((repo_label . "Synthetic")))))
                               (messages . nil)) nil))
     (should-not rendered)
     (should (equal emacsos-assist-web--run-id "new-run"))
     (should (string-match-p "new accepted text" (buffer-string))))))

(ert-deftest test-send-draft-created-thread-follows-canonical-title-in-place ()
  (test-send-draft--with-thread
   (setq emacsos-assist-web--thread-id nil emacsos-assist-web--draft-id "new-thread"
         emacsos-assist-web--draft-repository "repo" emacsos-assist-web--draft-harness "deepagents"
         emacsos-assist-web--canonical-buffer-name-p t)
   (emacsos-assist-web--replace-input "first message")
   (let ((origin (current-buffer)))
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method _path _payload callback &rest _)
                  (funcall callback '((thread_id . "created-thread") (run_id . "first-run")) nil)))
               ((symbol-function 'emacsos-assist-web--observe-run) #'ignore))
       (call-interactively #'emacsos-assist-web-send))
     (emacsos-assist-web--replace-input "next draft")
     (emacsos-assist-web--render
      '((thread . ((id . "created-thread") (description . "Canonical title")
                   (status . "ready") (workspace . ((repo_label . "Synthetic")))))
        (messages . (((id . "message-1") (role . "user") (text . "first message")
                      (state . "final"))))))
     (should (eq (current-buffer) origin))
     (should (string-match-p "Canonical title" (buffer-name)))
     (should (equal (emacsos-assist-web--input) "next draft")))))

(ert-deftest test-send-draft-explicit-refresh-verifies-then-reattaches-one-live-observer ()
  (test-send-draft--with-thread
   (setq emacsos-assist-web--run-id "active-run"
         emacsos-assist-web--pending-accepted-p t
         emacsos-assist-web--submitted-text "accepted text"
         emacsos-assist-web--in-flight t)
   (let ((observed 0) paths)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method path _payload callback &rest _)
                  (push path paths)
                  (funcall callback
                           (if (string-match-p "/runs/" path)
                               '((thread_id . "draft-thread") (id . "active-run")
                                 (status . "running"))
                             '((thread . ((id . "draft-thread") (description . "Thread")
                                          (status . "processing") (workspace . ((repo_label . "Synthetic")))))
                               (messages . nil))) nil)))
               ((symbol-function 'emacsos-assist-web--observe-run)
                (lambda (&rest _) (cl-incf observed))))
       (call-interactively #'emacsos-assist-web-refresh-thread))
     (should (equal (nreverse paths) '("threads/draft-thread/runs/active-run" "threads/draft-thread")))
     (should (= observed 1))
     (should emacsos-assist-web--in-flight))))

(ert-deftest test-send-draft-terminal-server-run-retires-observer-without-dropping-http-draft ()
  (test-send-draft--with-thread
   (setq emacsos-assist-web--run-id "completed-run"
