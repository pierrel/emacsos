;;; test-phone-assist-notifications.el --- Reasoned attention consumer -*- lexical-binding: t; -*-
(require 'ert)
(require 'phone-assist-notifications)

(ert-deftest phone-assist-notifications-retries-ack-without-another-feedback-attempt ()
  (let* ((directory (make-temp-file "phone-attention-" t))
         (emacsos-assist-web-cache-directory (expand-file-name "cache" directory))
         (emacsos-notifications-file (expand-file-name "state/notifications.jsonl" directory))
         (emacsos-phone-notifications--owner nil)
         (alert '((thread_id . "thread-a") (id . "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
                  (reason . "Synthetic deadline needs attention")))
         requests feedback)
    (unwind-protect
        (cl-letf (((symbol-function 'emacsos-assist-web--request)
                   (lambda (method path _body callback &rest _)
                     (push (list method path) requests)
                     (if (equal method "GET")
                         (funcall callback `((notifications . (,alert))) nil)
                       (funcall callback nil "synthetic lost acknowledgment"))))
                  ((symbol-function 'emacsos-notifications-feedback)
                   (lambda (source reason id)
                     ;; The notification reason and per-thread claim must already exist.
                     (push (list source reason id
                                 (emacsos-notifications--rows)
                                 (emacsos-assist-web--read-cache "phone-notifications/thread-a.json")) feedback))))
          (emacsos-phone-notifications-poll)
          (emacsos-phone-notifications-poll)
          (should-not emacsos-phone-notifications--owner)
          (should (= (length feedback) 1))
          (should (eq (caar feedback) 'assist))
          (should (equal (alist-get 'reason (car (nth 3 (car feedback)))) (alist-get 'reason alert)))
          (should (equal (alist-get 'id (nth 4 (car feedback))) (alist-get 'id alert)))
          (should (= (length requests) 4))
          (should (= (file-modes emacsos-notifications-file) #o600))
          (emacsos-notifications-show)
          (should buffer-read-only)
          (should (string-match-p "Synthetic deadline needs attention" (buffer-string))))
      (delete-directory directory t))))

(ert-deftest phone-assist-notifications-never-vibrates-when-reason-or-claim-cannot-save ()
  (dolist (failure '(reason claim))
    (let* ((directory (make-temp-file "phone-attention-" t))
           (emacsos-assist-web-cache-directory directory)
           (emacsos-notifications-file (expand-file-name "notifications.jsonl" directory))
           (emacsos-phone-notifications--owner nil)
           (alert '((thread_id . "thread-a") (id . "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
                    (reason . "Synthetic deadline"))) feedback ack)
      (unwind-protect
          (cl-letf (((symbol-function 'emacsos-assist-web--request)
                     (lambda (method _path _body callback &rest _)
                       (if (equal method "GET") (funcall callback `((notifications . (,alert))) nil)
                         (setq ack t))))
                    ((symbol-function 'emacsos-notifications--record)
                     (lambda (&rest _) (when (eq failure 'reason) (error "synthetic unavailable"))))
                    ((symbol-function 'emacsos-assist-web--try-write-cache) (lambda (&rest _) nil))
                    ((symbol-function 'emacsos-notifications-feedback) (lambda (&rest _) (setq feedback t))))
            (emacsos-phone-notifications-poll)
            (should-not feedback) (should-not ack) (should-not emacsos-phone-notifications--owner))
        (delete-directory directory t)))))

(ert-deftest phone-assist-notifications-corrupt-receipt-does-not-starve-next-alert ()
  (let* ((directory (make-temp-file "phone-attention-" t))
         (emacsos-assist-web-cache-directory directory)
         (emacsos-notifications-file (expand-file-name "notifications.jsonl" directory))
         (emacsos-phone-notifications--owner nil)
         (alerts '(((thread_id . "thread-a") (id . "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") (reason . "First reason"))
                   ((thread_id . "thread-b") (id . "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb") (reason . "Second reason"))))
         feedback)
    (unwind-protect
        (progn
          (make-directory (expand-file-name "phone-notifications" directory))
          (with-temp-file (expand-file-name "phone-notifications/thread-a.json" directory) (insert "broken"))
          (cl-letf (((symbol-function 'emacsos-assist-web--request)
                     (lambda (method _path _body callback &rest _)
                       (funcall callback (when (equal method "GET") `((notifications . ,alerts))) nil)))
                    ((symbol-function 'emacsos-notifications-feedback)
                     (lambda (_source reason _id) (push reason feedback))))
            (emacsos-phone-notifications-poll)
            (should (equal feedback '("Second reason")))
            (should-not emacsos-phone-notifications--owner)))
      (delete-directory directory t))))

(ert-deftest phone-assist-notifications-start-is-idempotent ()
  (let ((emacsos-phone-notifications--timer nil) calls
        (original (symbol-function 'run-at-time)))
    (unwind-protect
        (cl-letf (((symbol-function 'run-at-time)
                   (lambda (start repeat function)
                     (push (list start repeat function) calls)
                     (funcall original 86400 nil #'ignore))))
          (emacsos-phone-notifications-start)
          (emacsos-phone-notifications-start)
          (should (equal calls '((0 30 emacsos-phone-notifications-poll)))))
      (when (timerp emacsos-phone-notifications--timer)
        (cancel-timer emacsos-phone-notifications--timer)))))

(ert-deftest phone-assist-notifications-malformed-async-response-releases-only-own-poll ()
  (let ((emacsos-phone-notifications--owner nil) callbacks)
    (cl-letf (((symbol-function 'emacsos-assist-web--request)
               (lambda (_method _path _body callback &rest _) (push callback callbacks))))
      (emacsos-phone-notifications-poll)
      (let ((old (car callbacks)))
        (condition-case nil (funcall old '((notifications . (1))) nil) (error nil))
        (should-not emacsos-phone-notifications--owner)
        (emacsos-phone-notifications-poll)
        (let ((new-owner emacsos-phone-notifications--owner))
          (funcall old '((notifications . (1))) nil)
          (should (eq new-owner emacsos-phone-notifications--owner)))
        (funcall (car callbacks) '((notifications)) nil)
        (should-not emacsos-phone-notifications--owner)))))

(ert-deftest phone-assist-notifications-reasons-match-single-line-journal-contract ()
  (dolist (unsafe '(#x85 #x9f #x2028 #x2029))
    (let ((reason (concat "Deadline" (string unsafe) "Act today")))
      (should-not (emacsos-notifications-valid-reason-p reason))
      (should-not (emacsos-phone-notifications--valid-alert-p
                   `((thread_id . "thread-a") (id . "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
                     (reason . ,reason))))))
  (should (emacsos-notifications-valid-reason-p "Family 👨‍👩‍👧‍👦 needs attention")))
