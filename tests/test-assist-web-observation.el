(ert-deftest test-observation-reopen-restores-draft-and-discovers-server-work ()
  (test-observation--with-thread
   (setq emacsos-assist-web--http-draft
         '(:key "emacsos-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" :text "unsent café 🐟\nsecond line"
           :target "observed-thread"))
   (emacsos-assist-web--save-draft)
   (with-temp-buffer
     (emacsos-assist-web-mode)
     (emacsos-assist-web--stop-thread-observation)
     (setq emacsos-assist-web--thread-id "observed-thread")
     (switch-to-buffer (current-buffer))
     (emacsos-assist-web--render (test-observation--snapshot "First answer"))
     (should (equal (emacsos-assist-web--input) "unsent café 🐟\nsecond line"))
     (let ((draft emacsos-assist-web--http-draft) observed)
       (cl-letf (((symbol-function 'emacsos-assist-web--request)
                  (lambda (method path _payload callback &rest _)
                    (should (equal method "GET"))
                    (funcall callback
                             (if (equal path "threads/observed-thread")
                                 (test-observation--snapshot "First answer" "reopened-run")
                               '((id . "reopened-run") (thread_id . "observed-thread")
                                 (status . "running"))) nil)))
                 ((symbol-function 'emacsos-assist-web--observe-run)
                  (lambda (_buffer) (setq observed t))))
         (emacsos-assist-web--observe-thread (current-buffer))
         (should observed)
         (should (eq draft emacsos-assist-web--http-draft))
         (should (equal (plist-get emacsos-assist-web--http-draft :key)
                        "emacsos-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
         (should-not emacsos-assist-web--submitted-text)
         (should (equal (emacsos-assist-web--input) "unsent café 🐟\nsecond line")))))))

