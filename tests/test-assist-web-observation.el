       (should-not requests)
       (emacsos-assist-web-send)
       (should (= (length requests) 1))
       (should (equal emacsos-assist-web--run-id "current-run"))
       (should emacsos-assist-web--in-flight)
       (should-not emacsos-assist-web--http-draft)))))

