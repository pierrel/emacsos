(ert-deftest test-observation-identical-read-clears-only-canonical-stale-presentation ()
  (test-observation--with-thread
   (let ((snapshot (copy-tree emacsos-assist-web--snapshot))
         (writes 0) (renders 0))
     (emacsos-assist-web--render snapshot t)
     ;; Exercise the real refresh failure, then recover through automatic polling.
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method _path _payload callback &rest _)
                  (funcall callback nil "offline"))))
       (emacsos-assist-web-refresh-thread))
     (should (string-match-p "refresh failed; cached" (buffer-string)))
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method _path _payload callback &rest _)
                  (funcall callback (copy-tree snapshot) nil)))
               ((symbol-function 'emacsos-assist-web--try-write-cache)
                (lambda (&rest _) (cl-incf writes)))
               ((symbol-function 'emacsos-assist-web--render)
                (lambda (&rest _) (cl-incf renders))))
       (emacsos-assist-web--observe-thread (current-buffer)))
     (should-not emacsos-assist-web--stream-status)
     (should (string-match-p "\\[ready\\]" (buffer-string)))
     (should-not (string-match-p "cached\\|refresh failed" (buffer-string)))
     (should (= writes 0))
     (should (= renders 0))
     (should (equal (emacsos-assist-web--input) "unsent café 🐟\nsecond line")))))

