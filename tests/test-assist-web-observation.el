(ert-deftest test-observation-hidden-denied-and-invalidated-views-stop-automatic-work ()
  (test-observation--with-thread
   (let (callback)
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (_method _path _payload response &rest _)
                  (setq callback response))))
       (setq emacsos-assist-web--denied t)
       (emacsos-assist-web--observe-thread (current-buffer))
       (should-not callback)
       (setq emacsos-assist-web--denied nil)
       (emacsos-assist-web--observe-thread (current-buffer))
