;;; test-assist-web-observation.el --- Whole-thread view tests -*- lexical-binding: t -*-
(require 'ert)
(require 'assist-web)

(defun test-observation--snapshot (answer &optional run)
  "Return bounded canonical history with ANSWER and optional active RUN."
  `((thread . ((id . "observed-thread") (description . "Observed")
               (status . ,(if run "processing" "ready"))
               (revision . "same-revision")
               (active_run . ,(when run `((id . ,run) (work_id . ,run) (status . "running"))))
               (workspace . ((repo_label . "Synthetic")))))
    (messages . (((id . "a-first") (role . "assistant") (text . ,answer) (state . "final"))))
    (has_older_messages . nil) (next_before . nil)))

(defmacro test-observation--with-thread (&rest body)
  "Run BODY in one visible thread with private temporary draft storage."
  `(let ((emacsos-assist-web-cache-directory (make-temp-file "observation-" t))
         (emacsos-assist-web--thread-safety (make-hash-table :test #'equal))
         (emacsos--assist-active-surface nil))
     (unwind-protect
         (save-window-excursion
           (with-temp-buffer
             (emacsos-assist-web-mode)
             (emacsos-assist-web--stop-thread-observation)
             (setq emacsos-assist-web--thread-id "observed-thread")
             (switch-to-buffer (current-buffer))
             (emacsos-assist-web--render (test-observation--snapshot "First answer"))
             (emacsos-assist-web--replace-input "unsent café 🐟\nsecond line")
             (cl-letf (((symbol-function 'emacsos-assist-web--git-note-safely) #'ignore)
                       ((symbol-function 'emacsos-assist-web--ack-rendered-thread) #'ignore))
               ,@body)))
       (delete-directory emacsos-assist-web-cache-directory t))))

(ert-deftest test-observation-follows-a-separate-run-and-renders-its-final-answer ()
  (test-observation--with-thread
   (let ((snapshot (test-observation--snapshot "First answer" "second-run"))
         (status "running") observed requests)
     (setf (alist-get 'messages snapshot)
           (append (alist-get 'messages snapshot)
                   '(((id . "u-second") (role . "user")
                      (text . "Follow-up request") (state . "incomplete")))))
     (cl-letf (((symbol-function 'emacsos-assist-web--request)
                (lambda (method path _payload callback &rest _)
                  (push (list method path) requests)
                  (should (equal method "GET"))
                  (funcall callback
                           (if (equal path "threads/observed-thread") (copy-tree snapshot)
                             `((id . ,(car (last (split-string path "/"))))
                               (thread_id . "observed-thread") (status . ,status))) nil)))
               ((symbol-function 'emacsos-assist-web--observe-run)
                (lambda (_buffer) (push emacsos-assist-web--run-id observed))))
       (emacsos-assist-web--observe-thread (current-buffer))
       (should (equal observed '("second-run")))
       (should-not emacsos-assist-web--http-draft)
       (should-not emacsos-assist-web--pending-key)
       (should-not emacsos-assist-web--submitted-text)
       ;; Discovery adds no fabricated user message or acceptance announcement.
       (should (= (how-many "you>" (point-min) (point-max)) 1))
       (should (= (how-many "Follow-up request" (point-min) (point-max)) 1))
       (emacsos-assist-web--dispatch-event
        (current-buffer) "assistant-reset" "{\"attempt\":1}")
       (emacsos-assist-web--dispatch-event
        (current-buffer) "assistant-delta" "{\"attempt\":1,\"index\":1,\"text\":\"Live second answer\"}")
       (should (string-match-p "Live second answer" (buffer-string)))
       (setq snapshot (test-observation--snapshot "First answer")
             status "success")
       (setf (alist-get 'messages snapshot)
             (append (alist-get 'messages snapshot)
                     '(((id . "u-second") (role . "user")
                        (text . "Follow-up request") (state . "final"))
                       ((id . "a-second") (role . "assistant")
                        (text . "Canonical second answer") (state . "final")))))
       (emacsos-assist-web--dispatch-event
        (current-buffer) "terminal" "{\"status\":\"success\"}")
       (should (string-match-p "Canonical second answer" (buffer-string)))
       (should-not (string-match-p "Live second answer" (buffer-string)))
       (should-not emacsos-assist-web--in-flight)
       (should-not emacsos-assist-web--run-id)
       (should (equal (emacsos-assist-web--input) "unsent café 🐟\nsecond line"))
       (should (equal (mapcar (lambda (message) (alist-get 'id message))
                              (alist-get 'messages emacsos-assist-web--snapshot))
                      '("a-first" "u-second" "a-second")))
       (should (< (string-match "First answer" (buffer-string))
                  (string-match "Follow-up request" (buffer-string))
                  (string-match "Canonical second answer" (buffer-string))))
       (should (= (length requests) 5))
       ;; A later server-selected work is discovered without a client FIFO.
       (setf (alist-get 'active_run (alist-get 'thread snapshot))
             '((id . "third-run") (work_id . "third-run") (status . "running"))
             (alist-get 'status (alist-get 'thread snapshot)) "processing")
       (setq status "running")
       (emacsos-assist-web--observe-thread (current-buffer))
       (should (equal observed '("third-run" "second-run")))
       (should (equal (emacsos-assist-web--input) "unsent café 🐟\nsecond line"))))))

