       (switch-to-buffer (get-buffer-create " *observation-hidden*"))
       (unwind-protect
           (cl-letf (((symbol-function 'emacsos-assist-web--request)
                      (lambda (&rest _) (ert-fail "Hidden view must not poll"))))
             (emacsos-assist-web--observe-thread buffer))
         (kill-buffer (current-buffer)))))))

