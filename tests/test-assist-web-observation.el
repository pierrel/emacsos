(ert-deftest test-observation-one-slow-exact-run-read-retains-its-buffer-owner ()
  (test-observation--with-thread
   (setq emacsos-assist-web--run-id "slow-run"
         emacsos-assist-web--pending-accepted-p t)
   (let ((emacsos-assist-web--requests nil)
         (emacsos-assist-web-api-url "https://assist.invalid/api/v1/phone")
         response callback (retrieved 0))
     (unwind-protect
         (cl-letf (((symbol-function 'emacsos-assist-web--read-token) (lambda () "synthetic-token"))
                   ((symbol-function 'emacsos-assist-web--trustfiles) (lambda () nil))
                   ((symbol-function 'url-retrieve)
                    (lambda (_url complete &rest _)
                      (cl-incf retrieved)
                      (setq response (generate-new-buffer " *slow-observation-response*")
                            callback complete)
                      (make-pipe-process :name "slow-observation" :buffer response :noquery t)
                      response)))
           (emacsos-assist-web--observe-thread (current-buffer))
           (should (= retrieved 1))
           (should (eq (buffer-local-value 'emacsos-assist-web--request-origin response)
                       (current-buffer)))
           (emacsos-assist-web--observe-thread (current-buffer))
           (should (= retrieved 1))
           (with-current-buffer response
             (setq-local url-http-response-status nil)
             (funcall callback '(:error (error synthetic-transport)))))
       (when (buffer-live-p response) (kill-buffer response))))))
