;;; test-conversation-rendering.el --- Native local object regressions -*- lexical-binding: t -*-
(require 'ert)
(require 'chat)
(require 'emacsos-typography)

(defconst rendering-test--table
  "| Item | kcal | P | C | F |\n|------|------|---|---|---|\n| 1 slice bread + Kite Hill cream cheese + nutritional yeast | 236 | 10g | 27g | 9g |\n| ½ chocolate croissant | 110 | 2.5g | 14g | 6g |\n| ½ small coffee cake | 125 | 2g | 17.5g | 5.5g |\n| **Total** | **470** | **15g** | **59g** | **20g** |\n| 界 | 1 | 2 | 3 | 4 |\n")

(ert-deftest rendering-paths-map-only-the-current-workspace ()
  (let ((root (make-temp-file "render-workspace" t))
        (outside (make-temp-file "render-outside" t)))
    (unwind-protect
        (progn
          (write-region "one" nil (expand-file-name "notes.md" root) nil 'silent)
          (write-region "two" nil (expand-file-name "notes.md" outside) nil 'silent)
          (make-symbolic-link outside (expand-file-name "escape" root))
          (make-directory (expand-file-name ".git" root))
          (write-region "private" nil (expand-file-name ".git/config" root) nil 'silent)
          (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory)
                     (lambda () root)))
            (dolist (path '("notes.md" "/user/notes.md" "/workspace/notes.md"))
              (should (equal (emacsos-conversation--local-file path) (expand-file-name "notes.md" root))))
            (dolist (path '("../notes.md" "escape/notes.md" "/tmp/notes.md" ".git/config" "/etc/passwd" "/ssh:host:/etc/passwd" "missing.md"))
              (should-not (emacsos-conversation--local-file path))))
          (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () outside)))
            (should (equal (emacsos-conversation--local-file "notes.md") (expand-file-name "notes.md" outside)))))
      (delete-directory root t) (delete-directory outside t))))

(ert-deftest rendering-files-use-explicit-local-objects-and-preserve-source ()
  (with-temp-buffer
    (emacsos--chat-enable-presentation)
    (insert "bot> Here:\n```render\ntype: file\npath: /workspace/notes.md\nlines: 2-4\n```\n[notes](/user/notes.md)\n```render\ntype: map\npin: 1,2 x\n```\n> unsent draft")
    (let ((source (buffer-substring-no-properties (point-min) (point-max))))
      (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () nil)))
        (emacsos--chat-present-message 1 6 (- (point-max) 14) 'assistant))
      (should (equal source (buffer-substring-no-properties (point-min) (point-max))))
      (goto-char (point-min)) (search-forward "```render")
      (should (equal (get-text-property (match-beginning 0) 'emacsos-conversation-object)
                     '(file "/workspace/notes.md" "2-4")))
      (should (string-match-p "Unavailable locally" (get-text-property (match-beginning 0) 'display)))
      (search-forward "notes]")
      (should (equal (get-text-property (- (point) 3) 'emacsos-conversation-object)
                     '(file "/user/notes.md" nil)))
      (search-forward "type: map")
      (should-not (get-text-property (match-beginning 0) 'display))
      (let ((kill-ring nil))
        (kill-ring-save (point-min) (point-max))
        (should (equal (car kill-ring) source))))))

(ert-deftest rendering-example-table-aligns-unicode-and-keeps-return-draft ()
  (save-window-excursion
    (let ((source (generate-new-buffer " *render-conversation*")) view)
      (unwind-protect
          (progn
            (switch-to-buffer source)
            (emacsos--chat-enable-presentation)
            (insert "bot> " rendering-test--table "\n> unfinished draft")
            (let ((original (buffer-substring-no-properties (point-min) (point-max))))
              (emacsos--chat-present-message 1 6 (- (point-max) 18) 'assistant)
              (goto-char 6)
              (should (eq (car (get-text-property (point) 'emacsos-conversation-object)) 'table))
              (emacsos-conversation--open-object)
              (setq view (current-buffer))
              (should truncate-lines) (should-not word-wrap)
              (should (equal (lookup-key (current-local-map) (kbd "C-c b")) #'emacsos-conversation-table-back))
              (let (positions)
                (goto-char (point-min))
                (while (not (eobp))
                  (let (columns)
                    (while (search-forward "|" (line-end-position) t)
                      (push (current-column) columns))
                    (push (nreverse columns) positions))
                  (forward-line 1))
                (should (cl-every (lambda (row) (equal row (car positions))) positions)))
              (emacsos-conversation-table-scroll-right)
              (should (= (window-hscroll) 12))
              (should header-line-format)
              (emacsos-conversation-table-back)
              (should (eq (current-buffer) source))
              (should-not truncate-lines)
              (should (equal original (buffer-substring-no-properties (point-min) (point-max))))))
        (when (buffer-live-p view) (kill-buffer view)) (kill-buffer source)))))

(ert-deftest rendering-fences-isolate-nested-objects-and-representation-refresh ()
  (with-temp-buffer
    (insert "```text\n```render\ntype: file\npath: notes.md\n```\n" rendering-test--table "\n" rendering-test--table)
    (emacsos--chat-present-markdown-1 (point-min) (point-max))
    (goto-char (point-min)) (search-forward "type: file")
    (should-not (get-text-property (point) 'emacsos-conversation-object))
    (goto-char (point-min)) (search-forward "| Item")
    (should (get-text-property (match-beginning 0) 'emacsos-conversation-object))
    (let ((start (match-beginning 0)))
      (search-forward "| Item")
      (should (get-text-property (match-beginning 0) 'emacsos-conversation-object))
      (goto-char start)
      (delete-region start (progn (forward-line 1) (point)))
      (emacsos--chat-present-markdown-1 (point-min) (point-max))
      (should-not (get-text-property start 'display)))))

(ert-deftest rendering-png-checks-bounded-actual-bytes-before-decoding ()
  (let ((file (make-temp-file "render-image" nil ".png")) seen)
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'no-conversion))
            (write-region (base64-decode-string "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jD1sAAAAASUVORK5CYII=") nil file nil 'silent))
          (cl-letf (((symbol-function 'display-images-p) (lambda (&rest _) t))
                    ((symbol-function 'create-image) (lambda (data type &rest _) (setq seen (list data type)) '(image))))
            (should (equal (emacsos-conversation--png file) '(image)))
            (should (eq (cadr seen) 'png))
            (should (equal (substring (car seen) 1 4) "PNG"))
            (let ((data (copy-sequence (car seen))) (coding-system-for-write 'no-conversion))
              (aset data 16 127)
              (write-region data nil file nil 'silent))
            (setq seen nil)
            (should-not (emacsos-conversation--png file))
            (should-not seen)))
      (delete-file file))))


(ert-deftest rendering-link-opener-rechecks-current-file-and-suppresses-svg-decoding ()
  (let ((root (make-temp-file "render-open" t)) opened mode range)
    (unwind-protect
        (progn
          (write-region "<svg/>" nil (expand-file-name "drawing.svg" root) nil 'silent)
          (with-temp-buffer
            (insert "[drawing](/workspace/drawing.svg)")
            (emacsos--chat-present-markdown-1 (point-min) (point-max))
            (goto-char 2)
            (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () root))
                      ((symbol-function 'emacsos-assist-web-find-file)
                       (lambda (file) (setq opened file mode (assoc-default file auto-mode-alist #'string-match)))))
              (emacsos-conversation--open-object)
              (should (equal opened (expand-file-name "drawing.svg" root)))
              (should (eq mode 'fundamental-mode))
              (delete-file opened)
              (setq opened nil)
              (emacsos-conversation--open-object)
              (should-not opened))))
      (delete-directory root t))))

(ert-deftest rendering-huge-alignment-does-not-amplify-small-source ()
  (save-window-excursion
    (let* ((source (concat "| A | B |\n|---|---|\n| " (make-string 10000 ?a) " | b |\n"
                           (apply #'concat (make-list 100 "| a | b |\n"))))
           view)
      (unwind-protect
          (progn
            (emacsos-conversation--table-view source)
            (setq view (current-buffer))
            (should (< (buffer-size) (+ (length source) 100)))
            (should (string-prefix-p "Table exceeds alignment limit" (buffer-string))))
        (when view (kill-buffer view))))))

