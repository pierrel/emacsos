(ert-deftest rendering-fallback-images-open-literally-without-decoding ()
  (require 'assist-web)
  (save-window-excursion
    (let ((root (make-temp-file "render-fallback" t))
          (source (generate-new-buffer " *render-fallback-source*"))
          (decoded nil) view)
      (unwind-protect
          (progn
            (let ((data (base64-decode-string "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jD1sAAAAASUVORK5CYII="))
                  (coding-system-for-write 'no-conversion))
              (aset data 18 16) (aset data 22 16)
              (write-region data nil (expand-file-name "large.png" root) nil 'silent)
              (write-region "GIF89a" nil (expand-file-name "other.gif" root) nil 'silent))
            (dolist (name '("large.png" "other.gif"))
              (switch-to-buffer source)
              (erase-buffer)
              (insert (format "[image](%s)" name))
              (emacsos--chat-present-markdown-1 1 (point-max))
              (goto-char 2)
              (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () root))
                        ((symbol-function 'image-mode) (lambda () (setq decoded t) (fundamental-mode))))
                (emacsos-conversation--open-object))
              (setq view (current-buffer))
              (should (equal buffer-file-name (expand-file-name name root)))
              (should (eq major-mode 'fundamental-mode))
              (should-not decoded)
              (should-not (buffer-modified-p))
              (kill-buffer view) (setq view nil)))
        (when view (kill-buffer view))
        (kill-buffer source) (delete-directory root t)))))

(ert-deftest rendering-repeated-pngs-reuse-one-display-across-messages ()
  (let ((root (make-temp-file "render-message-cache" t)) (decodes 0) (reads 0)
        (reader (symbol-function 'insert-file-contents-literally)))
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'no-conversion))
            (write-region
             (concat (base64-decode-string "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jD1sAAAAASUVORK5CYII=")
                     (make-string 700000 0))
             nil (expand-file-name "one.png" root) nil 'silent))
          (with-temp-buffer
            (dotimes (_ 20) (insert "bot> ```render\ntype: file\npath: one.png\n```\n"))
            (let ((source (buffer-string)) first)
              (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () root))
                        ((symbol-function 'display-images-p) (lambda (&rest _) t))
                        ((symbol-function 'insert-file-contents-literally)
                         (lambda (&rest args) (cl-incf reads) (apply reader args)))
                        ((symbol-function 'create-image)
                         (lambda (data type &rest _) (cl-incf decodes) (list 'image :type type :data data))))
                (dotimes (pass 3)
                  (emacsos--chat-present-transcript 1 (point-max))
                  (should (= reads (1+ pass))) (should (= decodes (1+ pass)))
                  (setq first nil)
                  (goto-char 1)
                  (while (search-forward "```render" nil t)
                    (let ((display (get-text-property (match-beginning 0) 'display)))
                      (should (eq (car-safe display) 'image))
                      (if first (should (eq display first)) (setq first display))))))
              (should (equal source (buffer-substring-no-properties 1 (point-max)))))))
      (delete-directory root t))))

