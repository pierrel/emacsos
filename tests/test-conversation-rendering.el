(ert-deftest rendering-table-header-controls-select-clicked-window ()
  (save-window-excursion
    (let ((prose (generate-new-buffer " *render-prose*")) view table-window prose-window)
      (unwind-protect
          (progn
            (switch-to-buffer prose) (insert "wrapped prose")
            (setq prose-window (selected-window))
            (emacsos-conversation--table-view rendering-test--table)
            (setq view (current-buffer) table-window (selected-window))
            (setq prose-window (split-window table-window nil 'below))
            (set-window-buffer prose-window prose)
            (select-window prose-window)
            (let ((last-input-event (list 'mouse-1 (list table-window 'header-line '(0 . 0) 0))))
              (emacsos-conversation-table-scroll-right))
            (should (eq (selected-window) table-window))
            (should (= (window-hscroll table-window) 12))
            (should (= (window-hscroll prose-window) 0))
            (should-not auto-hscroll-mode))
        (when view (kill-buffer view)) (kill-buffer prose)))))

(ert-deftest rendering-real-local-opener-preserves-file-bytes-and-rejects-file-eval ()
  (require 'assist-web)
  (save-window-excursion
    (let* ((root (make-temp-file "render-real-open" t))
           (file (expand-file-name "notes.el" root))
           (source (generate-new-buffer " *render-file-source*")) view
           (rendering-test-evaluated nil)
           (safe-local-eval-forms '((setq rendering-test-evaluated t))))
      (unwind-protect
          (progn
            (write-region (concat ";;; notes\n;; Local " "Variables:\n;; eval: (setq rendering-test-evaluated t)\n;; End:\n") nil file nil 'silent)
            (switch-to-buffer source)
            (insert "[notes](</workspace/notes.el:2>)")
            (emacsos--chat-present-markdown-1 1 (point-max))
            (goto-char 2)
            (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () root)))
              (emacsos-conversation--open-object))
            (setq view (current-buffer))
            (should (equal buffer-file-name file))
            (should (= (line-number-at-pos) 2))
            (should-not rendering-test-evaluated)
            (should-not (buffer-modified-p)))
        (when (and view (not (eq view source))) (kill-buffer view))
        (kill-buffer source) (delete-directory root t)))))


(ert-deftest rendering-repeated-and-distinct-pngs-share-whole-buffer-budget ()
  (let ((root (make-temp-file "render-budget" t)) (decodes 0))
    (unwind-protect
        (progn
          (let* ((data (concat (base64-decode-string "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jD1sAAAAASUVORK5CYII=")
                               (make-string 700000 0)))
                 (coding-system-for-write 'no-conversion))
            (write-region data nil (expand-file-name "one.png" root) nil 'silent)
            (write-region data nil (expand-file-name "two.png" root) nil 'silent))
          (with-temp-buffer
            (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () root))
                      ((symbol-function 'display-images-p) (lambda (&rest _) t))
                      ((symbol-function 'create-image)
                       (lambda (data type &rest _) (cl-incf decodes) (list 'image :type type :data data))))
              (dotimes (_ 1000) (insert "```render\ntype: file\npath: one.png\n```\n"))
              (emacsos--chat-present-markdown-1 1 (point-max))
              (should (= decodes 1))
              (should (eq (car (get-text-property 1 'display)) 'image))
              (goto-char (point-max))
              (let ((start (point)))
                (insert "```render\ntype: file\npath: two.png\n```\n")
                (emacsos--chat-present-markdown-1 start (point-max))
                (should (= decodes 1))
                (should (stringp (get-text-property start 'display)))))))
      (delete-directory root t))))

