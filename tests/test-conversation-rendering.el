          (dotimes (index 20)
            (unless (= index 0)
              (add-name-to-file (expand-file-name "invalid-0.png" root)
                                (expand-file-name (format "invalid-%d.png" index) root))))
          (with-temp-buffer
            (dotimes (index 20)
              (insert (format "bot> ```render\ntype: file\npath: invalid-%d.png\n```\n" index)))
            (cl-letf (((symbol-function 'emacsos-assist-web-git-local-directory) (lambda () root))
                      ((symbol-function 'display-images-p) (lambda (&rest _) t))
                      ((symbol-function 'insert-file-contents-literally)
                       (lambda (&rest args) (cl-incf reads) (apply reader args))))
              (emacsos--chat-present-transcript 1 (point-max)))
            (should (= reads 1))))
