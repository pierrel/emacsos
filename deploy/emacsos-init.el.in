;;; emacsos-init.el --- EmacsOS phone init snippet -*- lexical-binding: t -*-
;;
;; Generated by `make phone-install` from deploy/emacsos-init.el.in.
;; Source from the phone's main init.el (once):
;;
;;   (load-file "~/.emacs.d/emacsos-init.el")
;;
;; Subsequent `make phone-install` runs replace this file in place;
;; never edits the phone's init.el.

(let ((emacsos-dir (expand-file-name "~/.emacs.d/emacsos")))
  (add-to-list 'load-path emacsos-dir))

(require 'os)

;; Where the agent-applied config lives.  THE PHONE OWNS THIS PATH:
;; `apply_config` (server) reads this defvar over the wire and writes
;; here, falling back to the same literal if it's somehow unbound — so
;; the server constant and this path can't silently diverge (which
;; would make applies work live but vanish on reboot).  Keep in sync
;; with apply.DEFAULT_PHONE_AGENT_FILE.
(defvar emacos-agent-file "~/.emacs.d/emacsos/agent.el"
  "File the agent's applied config is written to and loaded from.")

;; Chat server URL.  Baked in at install time from DEV_BOX_URL.
;; Re-run `make phone-install DEV_BOX_URL=...` to change.
(setq emacos-chat-server-url "@@CHAT_URL@@")

;; TCP server so emacsclient from the dev box can reach this daemon.
;; (server-running-p) is idempotent: skip if some earlier init already
;; started the server.
(setq server-use-tcp t
      server-host "0.0.0.0")
(unless (and (boundp 'server-process) (server-running-p))
  (server-start))

;; Load the agent-applied config LAST so it layers on top of the base
;; (and can override it).  Guarded: a config that errors must not brick
;; boot — it just logs and leaves the phone on the last-known-good base.
;; This is the boot-time half of the apply/rollback honesty contract:
;; `apply_config` reports a load error live, and the user rolls back;
;; here we make sure a bad config that slipped through can't wedge the
;; device on the next restart.
(let ((f (expand-file-name emacos-agent-file)))
  (condition-case err
      (when (file-exists-p f)
        (load-file f))
    (error (message "emacsos: agent.el failed to load: %S" err))))

(provide 'emacsos-init)
;;; emacsos-init.el ends here
