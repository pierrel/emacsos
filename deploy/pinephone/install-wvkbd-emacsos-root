#!/bin/sh
# Fixed entrypoint: serialise an activation through the installed recovery helper.
set -eu
PATH=/usr/bin:/usr/sbin:/bin:/sbin; export PATH
umask 077
lock=/run/wvkbd-emacsos-install.lock
helper=/usr/local/sbin/emacsos-wvkbd-transaction
initd=/etc/init.d/emacsos-ui

fail() { printf 'wvkbd-install: %s\n' "$1" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || fail 'must run as root'
[ "$#" -eq 0 ] || fail 'arguments are not accepted'
[ "${SUDO_USER-}" = user ] || fail 'must be authorized by the recovery user'
[ -f "$helper" ] && [ ! -L "$helper" ] &&
    [ "$(stat -c '%U:%G:%a:%h:%F' "$helper")" = 'root:root:755:1:regular file' ] ||
    fail 'recovery helper is not installed safely'
[ -f "$initd" ] && [ ! -L "$initd" ] &&
    [ "$(stat -c '%U:%G:%a:%h:%F' "$initd")" = 'root:root:755:1:regular file' ] &&
    grep -F '/usr/local/sbin/emacsos-wvkbd-transaction prepare-start || return 1' "$initd" >/dev/null &&
    grep -F '/usr/local/sbin/emacsos-wvkbd-transaction verify-start' "$initd" >/dev/null ||
    fail 'OpenRC UI transaction hooks are not installed safely'
touch "$lock"; chown root:root "$lock"; chmod 0600 "$lock"
exec 9>"$lock"; flock -n -x 9 || fail 'install is already running'
exec "$helper" activate
