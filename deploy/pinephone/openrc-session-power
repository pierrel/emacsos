#!/bin/sh
# Serialize display and suspend state for the minimal OpenRC session.

set -eu
PATH=/usr/bin:/usr/sbin:/bin:/sbin
HOME=/var/lib/emacsos-lab
XDG_RUNTIME_DIR=/run/emacsos-ui
export PATH HOME XDG_RUNTIME_DIR
unset SWAYSOCK
umask 077

runtime=$XDG_RUNTIME_DIR
state=$runtime/power-state
generation_file=$runtime/power-generation
events=$runtime/power-events
lock=$runtime/power-state.lock
sway_socket=
wayland_socket=

fail() {
    printf 'emacsos-session-power: %s\n' "$1" >&2
    exit 1
}

trap 'exit 1' HUP INT TERM

[ "$#" -ge 1 ] || fail 'an action is required'
case $1 in
    press|idle-blank|resume|wake|monitor)
        [ "$#" -eq 1 ] || fail 'arguments are not accepted' ;;
    suspend)
        [ "$#" -eq 2 ] || fail 'a blank generation is required'
        case $2 in ''|*[!0-9]*) fail 'invalid blank generation' ;; esac ;;
    *) fail 'unknown action' ;;
esac

[ "$(id -un)" = emacsos-lab ] || fail 'wrong service user'
[ -d "$runtime" ] && [ ! -L "$runtime" ] || fail 'invalid runtime directory'
[ "$(stat -c '%U:%G:%a:%F' "$runtime")" = \
    'emacsos-lab:emacsos-lab:700:directory' ] || fail 'unsafe runtime directory'

for candidate in "$runtime"/sway-ipc.*.sock; do
    [ -S "$candidate" ] || continue
    [ -z "$sway_socket" ] || fail 'ambiguous Sway socket'
    [ "$(stat -c '%U:%G:%F' "$candidate")" = \
        'emacsos-lab:emacsos-lab:socket' ] || fail 'unsafe Sway socket'
    sway_socket=$candidate
done
[ -n "$sway_socket" ] || fail 'Sway socket is absent'
for candidate in "$runtime"/wayland-*; do
    [ -S "$candidate" ] || continue
    [ -z "$wayland_socket" ] || fail 'ambiguous Wayland socket'
    [ "$(stat -c '%U:%G:%F' "$candidate")" = \
        'emacsos-lab:emacsos-lab:socket' ] || fail 'unsafe Wayland socket'
    wayland_socket=$candidate
done
[ -n "$wayland_socket" ] || fail 'Wayland socket is absent'
WAYLAND_DISPLAY=${wayland_socket##*/}
export WAYLAND_DISPLAY

[ -p "$events" ] && [ ! -L "$events" ] || fail 'power timer pipe is absent'

# The session supervises this one worker. Seat activity cannot reset its
# deadline. A dark screen retries after each kernel return or failed suspend;
# an explicit wake cancels that generation.
if [ "$1" = monitor ]; then
    exec 8<>"$events"
    blank_generation=
    while :; do
        if [ -n "$blank_generation" ]; then
            if ! IFS= read -r -t 120 event <&8; then
                "$0" suspend "$blank_generation" 8>&- || true
                continue
            fi
        else
            IFS= read -r event <&8 || exit 1
        fi
        case $event in
            active) blank_generation= ;;
            blank:*) blank_generation=${event#blank:} ;;
        esac
    done
fi

: >"$lock"
chmod 0600 "$lock"
exec 9>"$lock"
case $1 in
    press|resume|wake) flock -x 9 || fail 'power transition lock failed' ;;
    idle-blank) flock -n -x 9 || fail 'power transition is busy' ;;
    suspend) flock -w 2 -x 9 || fail 'power transition is busy' ;;
esac

publish_state() {
    printf '%s\n' "$1" >"$state"
}

sway() {
    timeout -s TERM -k 1 3 swaymsg -s "$sway_socket" "$@" >/dev/null
}

publish_transition() {
    generation=$(cat "$generation_file" 2>/dev/null || printf 0)
    generation=$((generation + 1))
    printf '%s\n' "$generation" >"$generation_file"
    publish_state "$1"
    event=$1
    [ "$1" != blank ] || event="blank:$generation"
    timeout -s TERM -k 1 3 sh -c 'printf "%s\n" "$1" >"$2"' \
        sh "$event" "$events" || fail 'power timer is unavailable'
}

restore_active() {
    publish_state waking
    output_ok=0
    touch_ok=0
    activity_ok=0
    sway output DSI-1 power on && output_ok=1
    sway input type:touch events enabled && touch_ok=1
    if [ "$output_ok" -eq 1 ] && [ "$touch_ok" -eq 1 ]; then
        timeout -s TERM -k 1 3 /usr/bin/wtype -k F24 && activity_ok=1
    fi
    if [ "$output_ok" -eq 1 ] && [ "$touch_ok" -eq 1 ] &&
       [ "$activity_ok" -eq 1 ]; then
        publish_transition active
        return 0
    fi
    return 1
}

enter_blank() {
    publish_state blanking
    touch_ok=0
    output_ok=0
    sway input type:touch events disabled && touch_ok=1
    sway output DSI-1 power off && output_ok=1
    if [ "$touch_ok" -eq 1 ] && [ "$output_ok" -eq 1 ]; then
        publish_transition blank
        return 0
    fi
    restore_active || true
    return 1
}

if [ -f "$state" ] && [ ! -L "$state" ]; then
    current=$(sed -n '1p' "$state")
else
    current=unknown
fi
case $current in
    active|blank) ;;
    *)
        restore_active || fail 'could not recover interrupted power state'
        exit 0
        ;;
esac

case $1 in
    press)
        case $current in
            active) enter_blank ;;
            blank) restore_active ;;
        esac
        ;;
    idle-blank)
        [ "$current" != active ] || enter_blank
        ;;
    resume)
        # Seat resume includes volume and unsolicited input, not authorization
        # to light the display. Calls/SMS use wake; the power button uses press.
        ;;
    wake)
        restore_active
        ;;
    suspend)
        [ "$current" = blank ] || exit 0
        [ "$(cat "$generation_file")" = "$2" ] || exit 0
        set +e
        doas -n /usr/local/sbin/emacsos-openrc-suspend
        suspend_status=$?
        set -e
        case $suspend_status in
            0|75) exit 0 ;;
            *)
                printf 'emacsos-session-power: suspend failed (%s)\n' \
                    "$suspend_status" >&2
                exit "$suspend_status"
                ;;
        esac
        ;;
esac
