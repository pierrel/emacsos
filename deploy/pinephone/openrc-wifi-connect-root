#!/usr/bin/python3 -I
"""Bounded root helper for one credentialed Wi-Fi connection."""

import fcntl
import json
import os
import re
import secrets
import signal
import stat
import subprocess
import sys

MAX_REQUEST_BYTES = 1024
MAX_SSID_BYTES = 32
MAX_PASSWORD_BYTES = 256
LOCK_PATH = "/run/emacsos-openrc-network.lock"
PENDING_PATH = "/run/emacsos-openrc-wifi-pending"
NMCLI = "/usr/bin/nmcli"
PROFILE_PREFIX = "emacsos-wifi-attempt-"
# A complete attempt name is longer than any valid SSID, so publishing to the
# SSID can never leave an ordinary profile inside the reserved namespace.
PROFILE_RE = re.compile(rb"emacsos-wifi-attempt-[0-9a-f]{32}")
UUID_RE = re.compile(
    rb"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-"
    rb"[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}")


class InputTimeout(Exception):
    """The request writer did not complete within the input deadline."""


def _alarm(_signum, _frame):
    raise InputTimeout()


def _valid_line(value, maximum):
    """Return whether VALUE is a nonempty bounded string without NUL, CR, or LF."""
    return (isinstance(value, str) and value and "\0" not in value and
            "\r" not in value and "\n" not in value and
            len(value.encode("utf-8")) <= maximum)


def parse_request(raw):
    """Return validated ``(ssid, password)`` from bounded JSON bytes."""
    if len(raw) > MAX_REQUEST_BYTES:
        raise ValueError("oversized")
    value = json.loads(raw.decode("utf-8"))
    if not isinstance(value, dict) or set(value) != {"ssid", "password"}:
        raise ValueError("shape")
    ssid, password = value["ssid"], value["password"]
    if (not _valid_line(ssid, MAX_SSID_BYTES) or
            any(ord(char) < 32 or 127 <= ord(char) <= 159 or
                ord(char) in {0x061C, 0x200E, 0x200F} or
                0x202A <= ord(char) <= 0x202E or
                0x2066 <= ord(char) <= 0x2069 for char in ssid)):
        raise ValueError("ssid")
    if not _valid_line(password, MAX_PASSWORD_BYTES):
        raise ValueError("password")
    return ssid, password


def _emit(status):
    """Emit one controlled result without request or exception data."""
    sys.stdout.write(status + "\n")
    sys.stdout.flush()


def _kill_process_group(process):
    """Kill PROCESS's private process group and reap PROCESS."""
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()


def main():
    """Serialize, validate stdin, mutate NetworkManager, and ordinarily emit a result."""
    if os.geteuid() != 0 or len(sys.argv) != 1:
        _emit("not-connected:invalid-input")
        return 2
    try:
        flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW
        lock_fd = os.open(LOCK_PATH, flags, 0o600)
        info = os.fstat(lock_fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
                info.st_gid != 0 or info.st_nlink != 1):
            os.close(lock_fd)
            raise OSError("unsafe lock")
        os.fchmod(lock_fd, 0o600)
        lock_file = os.fdopen(lock_fd, "a+b")
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            _emit("not-connected:busy")
            return 1
    except OSError:
        _emit("not-connected:unavailable")
        return 1

    signal.signal(signal.SIGALRM, _alarm)
    signal.alarm(3)
    try:
        raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
        ssid, password = parse_request(raw)
    except InputTimeout:
        _emit("not-connected:invalid-input")
        return 2
    except (UnicodeError, ValueError, TypeError):
        _emit("not-connected:invalid-input")
        return 2
    finally:
        signal.alarm(0)

    if not os.access(NMCLI, os.X_OK):
        _emit("not-connected:unavailable")
        return 1
    process = None
    reconciliation_in_progress = False
    termination_signal = None
    operation_complete = False

    def terminate(signum, _frame):
        nonlocal termination_signal
        if operation_complete:
            return
        termination_signal = signum
        if (not reconciliation_in_progress and process is not None and
                process.poll() is None):
            _kill_process_group(process)

    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, terminate)
    blocked = {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}

    def start(arguments, *, stdin=subprocess.DEVNULL,
              stdout=subprocess.DEVNULL, cancellable=False):
        """Start one isolated nmcli child without a signal handoff race."""
        nonlocal process
        old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
        try:
            if cancellable and termination_signal is not None:
                return None
            process = subprocess.Popen(
                arguments,
                stdin=stdin,
                stdout=stdout,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                pass_fds=(lock_file.fileno(),),
                env={"PATH": "/usr/bin:/usr/sbin:/bin:/sbin",
                     "LC_ALL": "C"})
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
        return process

    def marker_value(kind, value):
        """Return one validated marker record, or ``None``."""
        encoded = value.encode("ascii", "strict")
        if ((kind == "name" and PROFILE_RE.fullmatch(encoded) is not None) or
                (kind == "uuid" and UUID_RE.fullmatch(encoded) is not None)):
            return kind.encode("ascii") + b"=" + encoded + b"\n"
        return None

    def read_pending_marker(path=PENDING_PATH):
        """Return ``(valid, kind, value)`` from one root-owned marker."""
        try:
            fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        except FileNotFoundError:
            return True, None, None
        except OSError:
            return False, None, None
        try:
            info = os.fstat(fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
                    info.st_gid != 0 or info.st_nlink != 1 or
                    info.st_mode & 0o777 != 0o644):
                return False, None, None
            raw = os.read(fd, 128)
            if os.read(fd, 1):
                return False, None, None
        finally:
            os.close(fd)
        for kind in ("name", "uuid"):
            prefix = kind.encode("ascii") + b"="
            if raw.startswith(prefix) and raw.endswith(b"\n"):
                value = raw[len(prefix):-1]
                try:
                    decoded = value.decode("ascii")
                except UnicodeError:
                    return False, None, None
                if marker_value(kind, decoded) == raw:
                    return True, kind, decoded
        return False, None, None

    def remove_marker(path, kind=None, value=None):
        """Remove a safe marker PATH, optionally requiring KIND and VALUE."""
        valid, actual_kind, actual_value = read_pending_marker(path)
        if not valid:
            return False
        if actual_kind is None:
            return True
        if kind is not None and (actual_kind, actual_value) != (kind, value):
            return False
        try:
            os.unlink(path)
        except OSError:
            return False
        return True

    def remove_marker_temp():
        """Remove only a bounded root-owned interrupted marker temporary."""
        path = PENDING_PATH + ".new"
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            return True
        except OSError:
            return False
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
                info.st_gid != 0 or info.st_nlink != 1 or
                info.st_size > 128 or info.st_mode & 0o022):
            return False
        try:
            os.unlink(path)
        except OSError:
            return False
        return True

    def write_pending_marker(kind, value, *, replace=False):
        """Publish one root-owned marker, atomically when replacing it."""
        raw = marker_value(kind, value)
        if raw is None:
            return False
        if not remove_marker_temp():
            return False
        if not replace:
            try:
                os.lstat(PENDING_PATH)
            except FileNotFoundError:
                pass
            except OSError:
                return False
            else:
                return False
        path = PENDING_PATH + ".new"
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                         os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
        except OSError:
            return False
        complete = False
        try:
            os.fchmod(fd, 0o644)
            complete = os.write(fd, raw) == len(raw)
            if complete:
                os.fsync(fd)
        except OSError:
            complete = False
        finally:
            os.close(fd)
        if not complete:
            remove_marker_temp()
            return False
        try:
            os.replace(path, PENDING_PATH)
        except OSError:
            remove_marker_temp()
            return False
        return True

    def discard_profile(profile_uuid):
        """Delete exact PROFILE_UUID while deferring termination signals."""
        nonlocal reconciliation_in_progress
        reconciliation_in_progress = True
        delete = start([NMCLI, "con", "delete", "uuid", profile_uuid])
        try:
            delete.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            _kill_process_group(delete)
            return False
        finally:
            reconciliation_in_progress = False
        return delete.returncode in (0, 10)

    def resolve_attempt_profile(profile_name):
        """Return ``(resolved, uuid)`` for one helper-owned profile name."""
        nonlocal reconciliation_in_progress
        reconciliation_in_progress = True
        lookup = start(
            [NMCLI, "-g", "UUID", "con", "show", "id", profile_name],
            stdout=subprocess.PIPE)
        try:
            output, _ = lookup.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            _kill_process_group(lookup)
            return False, None
        finally:
            reconciliation_in_progress = False
        uuids = output.splitlines()
        if lookup.returncode == 10 and not uuids:
            return True, None
        if (lookup.returncode != 0 or len(uuids) != 1 or
                UUID_RE.fullmatch(uuids[0]) is None):
            return False, None
        return True, uuids[0].decode("ascii")

    def discard_failed_profile(profile_name):
        """Delete only the uniquely named profile created by this attempt."""
        resolved, profile_uuid = resolve_attempt_profile(profile_name)
        if not resolved:
            return False
        if profile_uuid is None:
            return True
        return discard_profile(profile_uuid)

    def publish_connected_profile(profile_name):
        """Make a successfully connected attempt visible as an ordinary profile."""
        nonlocal operation_complete
        resolved, profile_uuid = resolve_attempt_profile(profile_name)
        if not resolved or profile_uuid is None:
            return False
        if not write_pending_marker("uuid", profile_uuid, replace=True):
            discard_profile(profile_uuid)
            return False
        if termination_signal is not None:
            if discard_profile(profile_uuid):
                remove_marker(PENDING_PATH, "uuid", profile_uuid)
            return False
        rename = start([NMCLI, "con", "modify", "uuid", profile_uuid,
                        "connection.id", ssid], cancellable=True)
        if rename is None:
            if discard_profile(profile_uuid):
                remove_marker(PENDING_PATH, "uuid", profile_uuid)
            return False
        try:
            rename.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            _kill_process_group(rename)
        if rename.returncode != 0 or termination_signal is not None:
            if discard_profile(profile_uuid):
                remove_marker(PENDING_PATH, "uuid", profile_uuid)
            return False
        old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
        try:
            if termination_signal is None and remove_marker(
                    PENDING_PATH, "uuid", profile_uuid):
                operation_complete = True
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
        if operation_complete:
            return True
        if discard_profile(profile_uuid):
            remove_marker(PENDING_PATH, "uuid", profile_uuid)
        return False

    try:
        if not remove_marker_temp():
            _emit("not-connected:unavailable")
            return 1
        valid_marker, pending_kind, pending_value = read_pending_marker()
        if not valid_marker:
            _emit("not-connected:unavailable")
            return 1
        if pending_kind == "name":
            discarded = discard_failed_profile(pending_value)
        elif pending_kind == "uuid":
            discarded = discard_profile(pending_value)
        else:
            discarded = True
        if (not discarded or
                (pending_kind is not None and not remove_marker(
                    PENDING_PATH, pending_kind, pending_value))):
            _emit("not-connected:unavailable")
            return 1
        if termination_signal is not None:
            _emit("not-connected:failed")
            return 1
        for _attempt in range(4):
            profile_name = PROFILE_PREFIX + secrets.token_hex(16)
            resolved, existing_uuid = resolve_attempt_profile(profile_name)
            if not resolved:
                _emit("not-connected:unavailable")
                return 1
            if existing_uuid is None:
                break
        else:
            _emit("not-connected:unavailable")
            return 1
        if termination_signal is not None:
            _emit("not-connected:failed")
            return 1
        if not write_pending_marker("name", profile_name):
            _emit("not-connected:unavailable")
            return 1
        process = start(
            [NMCLI, "--ask", "dev", "wifi", "connect", ssid,
             "name", profile_name],
            stdin=subprocess.PIPE, cancellable=True)
        if process is None:
            remove_marker(PENDING_PATH, "name", profile_name)
            _emit("not-connected:failed")
            return 1
        process.communicate(input=(password + "\n").encode("utf-8"), timeout=20)
        if process.returncode == 0 and termination_signal is None:
            status = ("connected" if publish_connected_profile(profile_name)
                      else "not-connected:unavailable")
        else:
            if discard_failed_profile(profile_name) and remove_marker(
                    PENDING_PATH, "name", profile_name):
                status = "not-connected:failed"
            else:
                status = "not-connected:unavailable"
    except subprocess.TimeoutExpired:
        _kill_process_group(process)
        status = "unknown:time-limit"
    except OSError:
        status = "not-connected:unavailable"
    finally:
        if process is not None and process.poll() is None:
            _kill_process_group(process)
    _emit(status)
    return 0 if status == "connected" else 1


if __name__ == "__main__":
    raise SystemExit(main())
