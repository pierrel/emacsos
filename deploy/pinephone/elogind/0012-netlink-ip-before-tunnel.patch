Subject: [PATCH] sd-netlink: define iphdr before tunnel structures

linux/if_tunnel.h embeds struct iphdr. Include its existing linux/ip.h
provider first. This is a header-order portability correction only.

--- a/src/libelogind/sd-netlink/netlink-types-rtnl.c
+++ b/src/libelogind/sd-netlink/netlink-types-rtnl.c
@@ -19,8 +19,8 @@
 #include <linux/if_bridge.h>
 #include <linux/if_link.h>
 #include <linux/if_macsec.h>
+#include <linux/ip.h>
 #include <linux/if_tunnel.h>
-#include <linux/ip.h>
 #include <linux/l2tp.h>
 #include <linux/net_namespace.h>
 #include <linux/netlink.h>
