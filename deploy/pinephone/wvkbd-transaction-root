#!/bin/sh
# Root-owned durable activation and recovery for the supervised wvkbd binary.
set -eu
PATH=/usr/bin:/usr/sbin:/bin:/sbin
export PATH
umask 077

target=/usr/local/bin/wvkbd-emacos
notice=/usr/local/share/licenses/wvkbd-emacos/wordninja.txt
state_dir=/var/lib/emacsos-wvkbd-transaction
state=$state_dir/state
previous=$state_dir/previous
previous_notice=$state_dir/previous-notice
service=emacsos-ui
ready=/run/emacsos-ui/ready
command='/usr/local/bin/wvkbd-emacos --mod-swipe -H 300 -L 300'
service_cgroup=/sys/fs/cgroup/openrc.emacsos-ui

fail() { printf 'wvkbd-transaction: %s\n' "$1" >&2; exit 1; }
sha() { sha256sum "$1" | awk '{print $1}'; }
checkpoint() { :; }

root_file() {
    [ -f "$1" ] && [ ! -L "$1" ] &&
        [ "$(stat -c '%U:%G:%a:%h:%F' "$1")" = "root:root:$2:1:regular file" ]
}

root_dir() {
    [ -d "$1" ] && [ ! -L "$1" ] &&
        [ "$(stat -c '%U:%G:%a:%F' "$1")" = "root:root:$2:directory" ]
}

safe_target() { root_file "$target" 755; }
safe_notice() { root_file "$notice" 644; }

# Copy user-owned staged input through the one descriptor we validated.  The
# root-only transaction directory makes the snapshot safe to hash and install.
snapshot_stage() {
    source=$1 snapshot=$2 maximum=$3
    /usr/bin/python3 - "$source" "$snapshot" "$maximum" <<'PY'
import os
import pwd
import stat
import sys

source, snapshot, maximum = sys.argv[1], sys.argv[2], int(sys.argv[3])
user = pwd.getpwnam("user")
fd = os.open(source, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
try:
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != user.pw_uid or
            info.st_gid != user.pw_gid or stat.S_IMODE(info.st_mode) != 0o600 or
            info.st_nlink != 1 or info.st_size > maximum):
        raise SystemExit("unsafe staged input")
    out = os.open(snapshot, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                  0o600)
    try:
        total = 0
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            total += len(chunk)
            if total > maximum:
                raise SystemExit("oversized staged input")
            view = memoryview(chunk)
            while view:
                view = view[os.write(out, view):]
        os.fsync(out)
    finally:
        os.close(out)
finally:
    os.close(fd)
PY
    root_file "$snapshot" 600 && [ "$(stat -c '%s' "$snapshot")" -le "$maximum" ] ||
        fail 'unsafe staged snapshot'
}

ensure_state_dir() {
    if [ -e "$state_dir" ] || [ -L "$state_dir" ]; then
        root_dir "$state_dir" 700 || fail 'unsafe transaction directory'
    else
        install -d -o root -g root -m 0700 "$state_dir"
    fi
}

sync_state() { sync "$state_dir"; }

remove_file() {
    [ ! -e "$1" ] && [ ! -L "$1" ] || rm -f -- "$1"
}

clear_state() {
    # The durable decision goes first. A later crash leaves only inert,
    # metadata-checked backups that no-state recovery may discard.
    checkpoint cleanup-state
    remove_file "$state"
    sync_state
    for file in "$previous_notice" "$previous" "$state_dir/candidate" "$state_dir/candidate-notice"; do
        if [ -e "$file" ] || [ -L "$file" ]; then
            root_file "$file" 600 || fail 'unsafe transaction cleanup metadata'
        fi
    done
    checkpoint cleanup-notice
    remove_file "$previous_notice"
    checkpoint cleanup-previous
    remove_file "$previous"
    remove_file "$state_dir/candidate"
    remove_file "$state_dir/candidate-notice"
    sync_state
}

write_state() {
    phase=$1 old_sha=$2 new_sha=$3 prior_notice=$4 boot_id=$5 owner_pid=$6 owner_start=$7
    temporary=$(mktemp "$state_dir/.state.XXXXXX")
    trap 'rm -f -- "${temporary-}"' EXIT HUP INT TERM
    printf 'version=2\nphase=%s\nold_sha=%s\nnew_sha=%s\nprior_notice=%s\nboot_id=%s\nowner_pid=%s\nowner_start=%s\n' "$phase" "$old_sha" "$new_sha" "$prior_notice" "$boot_id" "$owner_pid" "$owner_start" >"$temporary"
    chown root:root "$temporary"
    chmod 0600 "$temporary"
    root_file "$temporary" 600 || fail 'could not create safe state marker'
    mv -f -- "$temporary" "$state"
    temporary=
    trap - EXIT HUP INT TERM
    sync_state
}

read_state() {
    ensure_state_dir
    root_file "$state" 600 || fail 'unsafe transaction state'
    [ "$(stat -c '%s' "$state")" -le 512 ] || fail 'oversized transaction state'
    state_version=$(sed -n '1s/^version=//p' "$state")
    case $state_version in
        2) read_v2_state ;;
        1) read_v1_state ;;
        *) fail 'malformed transaction state' ;;
    esac
}

read_v2_state() {
    [ "$(wc -l <"$state")" -eq 8 ] || fail 'malformed transaction state'
    version=$(sed -n '1s/^version=//p' "$state")
    phase=$(sed -n '2s/^phase=//p' "$state")
    old_sha=$(sed -n '3s/^old_sha=//p' "$state")
    new_sha=$(sed -n '4s/^new_sha=//p' "$state")
    prior_notice=$(sed -n '5s/^prior_notice=//p' "$state")
    boot_id=$(sed -n '6s/^boot_id=//p' "$state")
    owner_pid=$(sed -n '7s/^owner_pid=//p' "$state"); owner_start=$(sed -n '8s/^owner_start=//p' "$state")
    [ "$version" = 2 ] && case $phase in pending|armed|testing|rollback|committed) true;; *) false;; esac &&
        printf '%s\n%s\n' "$old_sha" "$new_sha" | grep -Eq '^[0-9a-f]{64}$' &&
        { [ "$prior_notice" = 0 ] || [ "$prior_notice" = 1 ]; } &&
        case $phase in
            armed|testing)
                printf '%s\n' "$boot_id" | grep -Eq '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' &&
                    printf '%s\n%s\n' "$owner_pid" "$owner_start" | grep -Eq '^[1-9][0-9]*$'
                ;;
            *) [ "$boot_id" = - ] && [ "$owner_pid" = 0 ] && [ "$owner_start" = 0 ] ;;
        esac ||
        fail 'malformed transaction state'
    # Reject extra keys, reordered fields, and embedded control data.
    printf 'version=2\nphase=%s\nold_sha=%s\nnew_sha=%s\nprior_notice=%s\nboot_id=%s\nowner_pid=%s\nowner_start=%s\n' "$phase" "$old_sha" "$new_sha" "$prior_notice" "$boot_id" "$owner_pid" "$owner_start" | cmp -s - "$state" ||
        fail 'malformed transaction state'
}

legacy_cleanup_metadata() {
    for file in "$previous" "$previous_notice" "$state_dir/candidate" "$state_dir/candidate-notice"; do
        if [ -e "$file" ] || [ -L "$file" ]; then
            root_file "$file" 600 || fail 'unsafe legacy transaction cleanup metadata'
        fi
    done
}

read_v1_state() {
    [ "$(wc -l <"$state")" -eq 5 ] || fail 'malformed legacy transaction state'
    phase=$(sed -n '2s/^phase=//p' "$state")
    old_sha=$(sed -n '3s/^old_sha=//p' "$state")
    new_sha=$(sed -n '4s/^new_sha=//p' "$state")
    prior_notice=$(sed -n '5s/^prior_notice_present=//p' "$state")
    [ "$state_version" = 1 ] && case $phase in pending|committed) true;; *) false;; esac &&
        printf '%s\n%s\n' "$old_sha" "$new_sha" | grep -Eq '^[0-9a-f]{64}$' &&
        { [ "$prior_notice" = 0 ] || [ "$prior_notice" = 1 ]; } &&
        printf 'version=1\nphase=%s\nold_sha=%s\nnew_sha=%s\nprior_notice_present=%s\n' \
            "$phase" "$old_sha" "$new_sha" "$prior_notice" | cmp -s - "$state" ||
        fail 'malformed legacy transaction state'
    safe_target || fail 'unsafe legacy keyboard target'
    current_sha=$(sha "$target")
    case $phase in
        pending)
            { [ "$current_sha" = "$old_sha" ] || [ "$current_sha" = "$new_sha" ]; } ||
                fail 'legacy pending keyboard digest mismatch'
            verified_backup
            ;;
        committed)
            [ "$current_sha" = "$new_sha" ] || fail 'legacy committed keyboard digest mismatch'
            ;;
    esac
    legacy_cleanup_metadata
}

validate_upgrade() {
    if [ ! -e "$state_dir" ] && [ ! -L "$state_dir" ]; then
        return 0
    fi
    root_dir "$state_dir" 700 || fail 'unsafe transaction directory'
    if [ ! -e "$state" ] && [ ! -L "$state" ]; then
        legacy_cleanup_metadata
        return 0
    fi
    read_state
    [ "$state_version" = 1 ] || fail 'version-2 transaction requires its original helper'
}

normalize_upgrade() {
    ensure_state_dir
    if [ ! -e "$state" ] && [ ! -L "$state" ]; then
        remove_safe_orphans
        return 0
    fi
    read_state
    [ "$state_version" = 1 ] || fail 'version-2 transaction requires its original helper'
    case $phase in
        pending) restore_legacy_old; clear_state ;;
        committed) clear_state ;;
    esac
}

current_boot_id() {
    value=$(cat /proc/sys/kernel/random/boot_id) || return 1
    printf '%s\n' "$value" | grep -Ex '[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}'
}
owner_starttime() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
owner_live() { [ "$owner_pid" = "${1-}" ] && [ "$owner_start" = "$(owner_starttime "$owner_pid")" ]; }

verified_backup() {
    root_file "$previous" 600 || fail 'unsafe previous keyboard backup'
    [ "$(sha "$previous")" = "$old_sha" ] || fail 'previous keyboard digest mismatch'
    if [ "$prior_notice" = 1 ]; then
        root_file "$previous_notice" 600 || fail 'unsafe previous notice backup'
    elif [ -e "$previous_notice" ] || [ -L "$previous_notice" ]; then
        fail 'unexpected previous notice backup'
    fi
}

copy_checked() {
    source=$1 destination=$2 mode=$3 digest=$4
    temporary=$(mktemp "$(dirname -- "$destination")/.wvkbd.XXXXXX")
    trap 'rm -f -- "${temporary-}"' EXIT HUP INT TERM
    install -o root -g root -m "$mode" "$source" "$temporary"
    checkpoint "temporary-$destination"
    root_file "$temporary" "$mode" || fail 'unsafe temporary installation'
    [ "$(sha "$temporary")" = "$digest" ] || fail 'temporary digest mismatch'
    mv -f -- "$temporary" "$destination"
    checkpoint "renamed-$destination"
    temporary=
    trap - EXIT HUP INT TERM
    sync "$(dirname -- "$destination")"
    checkpoint "installed-$destination"
}

restore_old() {
    read_state
    [ "$phase" = rollback ] || fail 'restore requested outside rollback'
    verified_backup
    copy_checked "$previous" "$target" 755 "$old_sha"
    if [ "$prior_notice" = 1 ]; then
        install -d -o root -g root -m 0755 /usr/local/share/licenses/wvkbd-emacos
        copy_checked "$previous_notice" "$notice" 644 "$(sha "$previous_notice")"
    else
        if [ -e "$notice" ] || [ -L "$notice" ]; then
            safe_notice || fail 'unsafe current notice during restore'
            remove_file "$notice"
            sync /usr/local/share/licenses/wvkbd-emacos
        fi
    fi
    safe_target && [ "$(sha "$target")" = "$old_sha" ] || fail 'old keyboard restore failed'
}

safe_service_cgroup() {
    [ -d "$service_cgroup" ] && [ ! -L "$service_cgroup" ] &&
        [ "$(stat -c '%U:%G:%F' "$service_cgroup")" = 'root:root:directory' ] &&
        root_cgroup_file "$service_cgroup/cgroup.procs" &&
        root_cgroup_file "$service_cgroup/cgroup.events"
}

root_cgroup_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    case $(stat -c '%U:%G:%F' "$1") in
        'root:root:regular file'|'root:root:regular empty file') return 0 ;;
        *) return 1 ;;
    esac
}

keyboard_pid() {
    safe_service_cgroup || return 1
    count=0
    while IFS= read -r pid; do
        case $pid in ''|*[!0-9]*) return 1;; esac
        count=$((count + 1))
        [ "$count" -le 256 ] || return 1
        proc=/proc/$pid
        [ "$(stat -c '%U' "$proc" 2>/dev/null || true)" = emacsos-lab ] || continue
        [ -r "$proc/cmdline" ] || continue
        actual=$(tr '\000' ' ' <"$proc/cmdline" 2>/dev/null | sed 's/ $//' || true)
        [ "$actual" = "$command" ] && printf '%s\n' "$pid"
    done <"$service_cgroup/cgroup.procs"
    return 0
}

session_gate() {
    expected=$1
    safe_service_cgroup || return 1
    checkpoint session-cgroup
    [ -f "$ready" ] && [ ! -L "$ready" ] &&
        [ "$(stat -c '%U:%G:%a:%h:%F' "$ready")" = 'emacsos-lab:emacsos-lab:600:1:regular file' ] || return 1
    checkpoint session-ready-metadata
    printf '%s\n' ready | cmp -s - "$ready" || return 1
    checkpoint session-ready-content
    pids=$(keyboard_pid) || return 1
    [ "$(printf '%s\n' "$pids" | sed '/^$/d' | wc -l)" -eq 1 ] || return 1
    checkpoint session-keyboard
    pid=$(printf '%s\n' "$pids" | sed -n '1p')
    case $pid in ''|*[!0-9]*) return 1;; esac
    [ -e "/proc/$pid/exe" ] || return 1
    checkpoint session-proc-exe
    [ "$(sha "/proc/$pid/exe")" = "$expected" ]
}

service_gate() {
    rc-service "$service" status >/dev/null 2>&1 && session_gate "$1"
}

wait_session() {
    expected=$1 attempt=0
    while [ "$attempt" -lt 100 ]; do
        session_gate "$expected" && return 0
        attempt=$((attempt + 1))
        sleep 0.1
    done
    return 1
}

wait_service_gate() {
    expected=$1 attempt=0
    while [ "$attempt" -lt 100 ]; do
        service_gate "$expected" && return 0
        attempt=$((attempt + 1))
        sleep 0.1
    done
    return 1
}

restart_candidate() {
    checkpoint before-candidate-restart
    rm -f -- "$ready"
    checkpoint during-candidate-restart
    timeout 30 rc-service "$service" restart 7>&- 8>&- 9>&- >/dev/null 2>&1 &&
        wait_service_gate "$1" && checkpoint after-candidate-restart
}

normal_recovery() {
    rm -f -- "$ready"
    timeout 30 rc-service "$service" restart 7>&- 8>&- 9>&- >/dev/null 2>&1 &&
        wait_service_gate "$old_sha"
}

remove_safe_orphans() {
    for file in "$previous" "$previous_notice" "$state_dir/candidate" "$state_dir/candidate-notice"; do
        if [ -e "$file" ] || [ -L "$file" ]; then
            root_file "$file" 600 || fail 'unsafe orphan transaction backup'
            rm -f -- "$file"
        fi
    done
    sync_state
}

restore_legacy_old() {
    verified_backup
    copy_checked "$previous" "$target" 755 "$old_sha"
    if [ "$prior_notice" = 1 ]; then
        install -d -o root -g root -m 0755 /usr/local/share/licenses/wvkbd-emacos
        copy_checked "$previous_notice" "$notice" 644 "$(sha "$previous_notice")"
    elif [ -e "$notice" ] || [ -L "$notice" ]; then
        safe_notice || fail 'unsafe current notice during legacy restore'
        remove_file "$notice"
        sync /usr/local/share/licenses/wvkbd-emacos
    fi
    safe_target && [ "$(sha "$target")" = "$old_sha" ] || fail 'legacy old keyboard restore failed'
}

prepare_start() {
    ensure_state_dir
    if [ ! -e "$state" ] && [ ! -L "$state" ]; then
        # A crash before pending could leave only safe, unreachable backups.
        remove_safe_orphans
        return 0
    fi
    read_state
    if [ "$state_version" = 1 ]; then
        case $phase in
            pending) restore_legacy_old ;;
            committed) clear_state ;;
        esac
        return 0
    fi
    case $phase in
        armed)
            verified_backup
            if [ "$boot_id" = "$(current_boot_id)" ] && safe_target && [ "$(sha "$target")" = "$new_sha" ]; then
                owner_live "$owner_pid" || { write_state rollback "$old_sha" "$new_sha" "$prior_notice" - 0 0; restore_old; return 0; }
                write_state testing "$old_sha" "$new_sha" "$prior_notice" "$boot_id" "$owner_pid" "$owner_start"
                return 0
            fi
            write_state rollback "$old_sha" "$new_sha" "$prior_notice" - 0 0
            restore_old
            ;;
        pending|testing|rollback)
            verified_backup
            write_state rollback "$old_sha" "$new_sha" "$prior_notice" - 0 0
            restore_old
            ;;
        committed)
            safe_target && [ "$(sha "$target")" = "$new_sha" ] || fail 'committed keyboard digest mismatch'
            clear_state
            ;;
    esac
}

# This ordinary post-start proof has no transaction-state behavior.
verify_current() {
    safe_target || fail 'current keyboard is unsafe'
    current_sha=$(sha "$target")
    session_gate "$current_sha" || fail 'current keyboard session did not become ready'
}

verify_start() {
    if [ ! -e "$state" ] && [ ! -L "$state" ]; then
        return 0
    fi
    read_state
    if [ "$state_version" = 1 ]; then
        case $phase in
            pending)
                safe_target && [ "$(sha "$target")" = "$old_sha" ] ||
                    fail 'legacy restored keyboard digest mismatch'
                wait_session "$old_sha" || fail 'legacy restored keyboard session did not become ready'
                clear_state
                ;;
            committed)
                safe_target && [ "$(sha "$target")" = "$new_sha" ] ||
                    fail 'legacy committed keyboard digest mismatch'
                wait_session "$new_sha" || fail 'legacy committed keyboard session did not become ready'
                clear_state
                ;;
        esac
        return 0
    fi
    case $phase in
        testing)
            verified_backup
            [ "$boot_id" = "$(current_boot_id)" ] && owner_live "$owner_pid" || fail 'candidate testing owner is stale'
            safe_target && [ "$(sha "$target")" = "$new_sha" ] || fail 'candidate keyboard digest mismatch'
            wait_session "$new_sha" || fail 'candidate keyboard session did not become ready'
            ;;
        rollback)
            verified_backup
            safe_target && [ "$(sha "$target")" = "$old_sha" ] || fail 'restored keyboard digest mismatch'
            wait_session "$old_sha" || fail 'restored keyboard session did not become ready'
            clear_state
            ;;
        armed|pending)
            fail 'candidate state reached start_post without preparation'
            ;;
        committed)
            safe_target && [ "$(sha "$target")" = "$new_sha" ] || fail 'committed keyboard digest mismatch'
            wait_session "$new_sha" || fail 'committed keyboard session did not become ready'
            clear_state
            ;;
    esac
}

activate() {
    [ "$(id -u)" -eq 0 ] || fail 'must run as root'
    [ "${SUDO_USER-}" = user ] || fail 'must be authorized by the recovery user'
    stage=${WVKBD_STAGE-} expected_new=${WVKBD_SHA256-}
    notice_stage=${WVKBD_NOTICE_STAGE-} expected_notice=${WVKBD_NOTICE_SHA256-}
    printf '%s\n%s\n' "$expected_new" "$expected_notice" | grep -Eq '^[0-9a-f]{64}$' || fail 'invalid staged digest'
    printf '%s\n' "$stage" | grep -Eq '^/home/user/\.cache/wvkbd-emacos\.[A-Za-z0-9]{6}$' || fail 'unsafe keyboard stage path'
    printf '%s\n' "$notice_stage" | grep -Eq '^/home/user/\.cache/wvkbd-notice\.[A-Za-z0-9]{6}$' || fail 'unsafe notice stage path'
    ensure_state_dir
    [ ! -e "$state" ] && [ ! -L "$state" ] || fail 'unfinished transaction requires recovery'
    candidate_snapshot=$state_dir/candidate
    notice_snapshot=$state_dir/candidate-notice
    remove_safe_orphans
    snapshot_stage "$stage" "$candidate_snapshot" 16777216
    snapshot_stage "$notice_stage" "$notice_snapshot" 1048576
    [ "$(sha "$candidate_snapshot")" = "$expected_new" ] || fail 'staged keyboard digest mismatch'
    [ "$(sha "$notice_snapshot")" = "$expected_notice" ] || fail 'staged notice digest mismatch'
    safe_target || fail 'unsafe current keyboard'
    old_sha=$(sha "$target")
    copy_checked "$target" "$previous" 600 "$old_sha"
    prior_notice=0
    if [ -e "$notice" ] || [ -L "$notice" ]; then
        safe_notice || fail 'unsafe current notice'
        copy_checked "$notice" "$previous_notice" 600 "$(sha "$notice")"
        prior_notice=1
    fi
    sync_state
    checkpoint before-pending
    write_state pending "$old_sha" "$expected_new" "$prior_notice" - 0 0
    checkpoint after-pending
    install -d -o root -g root -m 0755 /usr/local/share/licenses/wvkbd-emacos
    copy_checked "$notice_snapshot" "$notice" 644 "$expected_notice"
    checkpoint after-notice-install
    copy_checked "$candidate_snapshot" "$target" 755 "$expected_new"
    checkpoint after-candidate-rename
    owner_pid=$$; owner_start=$(owner_starttime "$$"); printf '%s\n' "$owner_start" | grep -Eq '^[0-9]+$' || fail 'cannot bind activation owner'
    boot_id=$(current_boot_id) || fail 'cannot bind activation boot'
    write_state armed "$old_sha" "$expected_new" "$prior_notice" "$boot_id" "$owner_pid" "$owner_start"
    if restart_candidate "$expected_new"; then
        checkpoint after-candidate-gate
        read_state
        [ "$phase" = testing ] || fail "candidate state is not testing: $phase"
        [ "$boot_id" = "$(current_boot_id)" ] || fail 'candidate boot changed'
        safe_target && [ "$(sha "$target")" = "$expected_new" ] || fail 'candidate keyboard digest changed'
        owner_live "$$" || fail 'candidate owner changed'
        write_state committed "$old_sha" "$expected_new" "$prior_notice" - 0 0
        checkpoint after-committed
        clear_state
        remove_safe_orphans
        return 0
    fi
    read_state
    write_state rollback "$old_sha" "$new_sha" "$prior_notice" - 0 0
    restore_old || fail 'candidate failed and old keyboard could not be restored'
    if normal_recovery; then
        remove_safe_orphans
        printf '%s\n' 'candidate failed; old keyboard restored' >&2
        return 1
    fi
    fail 'candidate failed; old keyboard backup retained because rollback did not become ready'
}

[ "$#" -eq 1 ] || fail 'expected exactly one action'
case $1 in
    activate) activate ;;
    validate-upgrade) validate_upgrade ;;
    normalize-upgrade) normalize_upgrade ;;
    prepare-start) prepare_start ;;
    verify-start) verify_start ;;
    verify-current) verify_current ;;
    finalize-start) verify_start ;;
    *) fail 'unknown action' ;;
esac
