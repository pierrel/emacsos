#!/usr/bin/python3 -I
"""Fixed root helper for exact SMS sends, private journal receipts and acknowledgment."""

import fcntl
import json
import os
import re
import signal
import sys
import sqlite3
import uuid
from pathlib import Path
from datetime import datetime, timezone

import dbus

MAX_REQUEST_BYTES = 32768
MAX_BODY_BYTES = 4096
MAX_INCOMING_BYTES = 256 * 1024
NUMBER_RE = re.compile(r"\+?[0-9]{5,15}\Z")
SMS_PATH_RE = re.compile(r"/org/freedesktop/ModemManager1/SMS/[0-9]+\Z")
MM_NAME = "org.freedesktop.ModemManager1"
MM_ROOT = "/org/freedesktop/ModemManager1"
OBJECT_MANAGER = "org.freedesktop.DBus.ObjectManager"
MESSAGING = "org.freedesktop.ModemManager1.Modem.Messaging"
THREE_GPP = "org.freedesktop.ModemManager1.Modem.Modem3gpp"
SMS = "org.freedesktop.ModemManager1.Sms"
LOCK_PATH = "/run/emacsos-openrc-sms.lock"
JOURNAL_PATH = "/var/lib/emacsos-sms/messages.sqlite3"
ID_RE = re.compile(r"[A-Za-z0-9_-]{1,128}\Z")

# ModemManager's 3GPP values which can carry an SMS: home, roaming, and the
# LTE variants that explicitly retain SMS service.  Do not create an SMS
# object while the radio is searching, denied, or only emergency-capable.
SMS_READY_REGISTRATION_STATES = frozenset((1, 5, 6, 7, 9, 10))


class InputTimeout(Exception):
    """The request writer did not complete within the input deadline."""


def _alarm(_signum, _frame):
    raise InputTimeout()


def parse_request(raw):
    """Return validated ``(number, text)`` from bounded JSON bytes."""
    if len(raw) > MAX_REQUEST_BYTES:
        raise ValueError("oversized")
    value = json.loads(raw.decode("utf-8"))
    if not isinstance(value, dict) or set(value) != {"number", "text"}:
        raise ValueError("shape")
    number, text = value["number"], value["text"]
    if not isinstance(number, str) or not NUMBER_RE.fullmatch(number):
        raise ValueError("number")
    if (not isinstance(text, str) or not text or "\0" in text or
            len(text.encode("utf-8")) > MAX_BODY_BYTES):
        raise ValueError("text")
    return number, text


def _emit(status):
    """Emit one controlled terminal line without request or exception data."""
    sys.stdout.write(status + "\n")
    sys.stdout.flush()


def send_sms(bus, number, text, attempt=None):
    """Send exact NUMBER/TEXT through one captured ModemManager owner."""
    try:
        owner = str(bus.get_name_owner(MM_NAME))
        if not re.fullmatch(r":[0-9]+\.[0-9]+", owner):
            return "not-sent:dbus-unavailable"
        manager = dbus.Interface(bus.get_object(owner, MM_ROOT), OBJECT_MANAGER)
        objects = manager.GetManagedObjects(timeout=10)
        modems = [(str(path), interfaces) for path, interfaces in objects.items()
                  if MESSAGING in interfaces]
    except InputTimeout:
        raise
    except Exception:
        return "not-sent:dbus-unavailable"
    if not modems:
        return "not-sent:no-modem"
    if len(modems) != 1:
        return "not-sent:multiple-modems"

    modem_path, modem_interfaces = modems[0]
    try:
        registered = int(modem_interfaces[THREE_GPP]["RegistrationState"])
    except (KeyError, TypeError, ValueError):
        return "not-sent:no-service"
    if registered not in SMS_READY_REGISTRATION_STATES:
        return "not-sent:no-service"

    try:
        messaging = dbus.Interface(bus.get_object(owner, modem_path), MESSAGING)
    except InputTimeout:
        raise
    except Exception:
        return "not-sent:dbus-unavailable"

    try:
        if attempt is not None:
            attempt["create"] = True
        path = str(messaging.Create(
            dbus.Dictionary({"number": dbus.String(number),
                             "text": dbus.String(text)}, signature="sv"),
            timeout=15))
    except InputTimeout:
        raise
    except Exception:
        # Create may have reached ModemManager even if its reply was lost.
        return "unknown:create-failed"
    if not SMS_PATH_RE.fullmatch(path):
        return "unknown:create-failed"

    try:
        dbus.Interface(bus.get_object(owner, path), SMS).Send(timeout=30)
    except InputTimeout:
        raise
    except Exception:
        return "unknown:send-failed"

    # A successful Send call means ModemManager accepted the message.  It does
    # not prove carrier or recipient delivery.  Cleanup cannot change that.
    try:
        messaging.Delete(dbus.ObjectPath(path), timeout=10)
    except Exception:
        pass
    return "sent"


def journal():
    """Open the fixed root-private journal; no caller controls filesystem paths."""
    directory = Path(JOURNAL_PATH).parent
    if directory.is_symlink():
        raise ValueError("journal")
    directory.mkdir(mode=0o700, exist_ok=True)
    if directory.stat().st_uid != os.geteuid() or directory.stat().st_mode & 0o077:
        raise ValueError("journal")
    fd = os.open(JOURNAL_PATH, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    info = os.fstat(fd)
    os.close(fd)
    if info.st_uid != os.geteuid() or info.st_mode & 0o077 or info.st_nlink != 1:
        raise ValueError("journal")
    connection = sqlite3.connect(JOURNAL_PATH, timeout=2)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA synchronous=FULL")
    connection.execute("BEGIN IMMEDIATE")
    connection.execute("CREATE TABLE IF NOT EXISTS messages (id TEXT PRIMARY KEY, direction TEXT, number TEXT, text TEXT, status TEXT, occurred_at TEXT, observation TEXT UNIQUE, ack_status TEXT)")
    if "last_offered" not in {row[1] for row in connection.execute("PRAGMA table_info(messages)")}:
        connection.execute("ALTER TABLE messages ADD COLUMN last_offered INTEGER NOT NULL DEFAULT 0")
    if "archive_only" not in {row[1] for row in connection.execute("PRAGMA table_info(messages)")}:
        connection.execute("ALTER TABLE messages ADD COLUMN archive_only INTEGER NOT NULL DEFAULT 0")
        # Legacy incoming times were local rediscovery times, not SMS timestamps.
        # Preserve old IDs/content/times/ACKs but prevent pending history turns.
        connection.execute("UPDATE messages SET archive_only=1 WHERE direction='incoming'")
    connection.execute("CREATE TABLE IF NOT EXISTS incoming_inventory (content TEXT NOT NULL, ordinal INTEGER NOT NULL, message_id TEXT NOT NULL UNIQUE, PRIMARY KEY(content,ordinal))")
    if not connection.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='incoming_cutover'").fetchone():
        connection.execute("CREATE TABLE incoming_cutover (occurred_at TEXT NOT NULL)")
        if connection.execute("SELECT 1 FROM messages WHERE direction='incoming' LIMIT 1").fetchone():
            # Unidentified legacy inventory must remain history even if MM
            # publishes it later. This one-time source-time boundary is durable.
            connection.execute("INSERT INTO incoming_cutover VALUES (?)", (datetime.now(timezone.utc).isoformat(),))

    connection.commit()
    return connection


def begin_attempt(connection, message_id, number, text, occurred_at=None):
    """Only the first durable claimant may mutate the modem for this id."""
    connection.execute("BEGIN IMMEDIATE")
    row = connection.execute("SELECT * FROM messages WHERE id=?", (message_id,)).fetchone()
    if row:
        if (row["direction"], row["number"], row["text"]) != ("outgoing", number, text):
            raise ValueError("conflict")
        connection.commit()
        return row["status"], False
    connection.execute("INSERT INTO messages (id,direction,number,text,status,occurred_at,observation,ack_status) VALUES (?, 'outgoing', ?, ?, 'unknown', ?, NULL, NULL)",
                       (message_id, number, text, occurred_at or datetime.now(timezone.utc).isoformat()))
    connection.commit()
    return "unknown", True


def collect_incoming(connection, bus):
    """Capture retained received inventory without replaying namespace changes.

    Received objects are never deleted by this stack. Immutable content plus
    multiplicity therefore preserves independent identical messages across MM
    path/owner changes. High-water ordinals never shrink. Incoming event time
    comes from the original aware SMS Timestamp, never rediscovery time.
    Exact legacy observations retain UUID/time/ACK and become archive-only.
    """
    owner = str(bus.get_name_owner(MM_NAME))
    if not re.fullmatch(r":[0-9]+\.[0-9]+", owner):
        raise ValueError("owner")
    boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    objects = dbus.Interface(bus.get_object(owner, MM_ROOT), OBJECT_MANAGER).GetManagedObjects(timeout=10)
    messaging = [interfaces[MESSAGING] for interfaces in objects.values() if MESSAGING in interfaces]
    if len(messaging) != 1 or "Messages" not in messaging[0]:
        raise ValueError("messaging")
    paths = sorted({str(path) for path in messaging[0]["Messages"]})
    if any(not SMS_PATH_RE.fullmatch(path) for path in paths):
        raise ValueError("SMS path")
    groups = {}
    for path in paths:
        observation = boot + ":" + owner + ":" + path
        try:
            properties = dbus.Interface(bus.get_object(owner, path),
                                        "org.freedesktop.DBus.Properties").GetAll(SMS, timeout=2)
        except InputTimeout:
            raise
        except Exception:
            continue
        if int(properties.get("State", 0)) != 3:
            continue
        number, text = str(properties.get("Number", "")), str(properties.get("Text", ""))
        if "\0" in number or len(number.encode()) > 128 or "\0" in text or len(text.encode()) > MAX_INCOMING_BYTES:
            continue
        # Received payload/origin fields only: State, Storage and delivery
        # report properties describe mutable lifecycle, not message content.
        content = json.dumps([number, text, list(map(int, properties.get("Data", []))),
                              str(properties.get("Timestamp", "")), str(properties.get("SMSC", "")),
                              int(properties.get("PduType", 0)), int(properties.get("Class", -1))],
                             ensure_ascii=False, separators=(",", ":"))
        try:
            timestamp = datetime.fromisoformat(str(properties.get("Timestamp", "")))
            occurred_at = timestamp.isoformat() if timestamp.tzinfo is not None else None
        except (TypeError, ValueError):
            occurred_at = None
        groups.setdefault(content, []).append((observation, number, text, occurred_at))
    connection.execute("BEGIN IMMEDIATE")
    cutover = connection.execute("SELECT occurred_at FROM incoming_cutover").fetchone()
    for content, members in groups.items():
        count = connection.execute("SELECT COUNT(*) FROM incoming_inventory WHERE content=?", (content,)).fetchone()[0]
        candidates = []
        for observation, number, text, occurred_at in members:
            legacy = connection.execute("SELECT * FROM messages WHERE observation=?", (observation,)).fetchone()
            mapped = connection.execute("SELECT content FROM incoming_inventory WHERE message_id=?", (legacy["id"],)).fetchone() if legacy else None
            if mapped:
                if mapped["content"] == content:
                    continue
                legacy = None
            candidates.append((observation, number, text, occurred_at, legacy))
        additional = max(0, len(members) - count)
        for ordinal, (observation, number, text, occurred_at, legacy) in enumerate(candidates[-additional:] if additional else [], count + 1):
            if legacy and (legacy["direction"], legacy["number"], legacy["text"]) != ("incoming", number, text):
                # MM may reuse a path within the same owner. It is not proof
                # that this current content is the legacy row's message.
                legacy = None
            if legacy:
                identity = legacy["id"]
                # Older clients recorded rediscovery time. Keep their immutable
                # payload/time/ACK; pending legacy receipts must not fire turns.
                connection.execute("UPDATE messages SET archive_only=1 WHERE id=?", (identity,))
            else:
                identity = uuid.uuid4().hex
                archive_only = occurred_at is None or (cutover is not None and
                    datetime.fromisoformat(occurred_at) <= datetime.fromisoformat(cutover["occurred_at"]))
                saved_observation = None if connection.execute("SELECT 1 FROM messages WHERE observation=?", (observation,)).fetchone() else observation
                connection.execute("INSERT INTO messages (id,direction,number,text,status,occurred_at,observation,ack_status,archive_only) VALUES (?, 'incoming', ?, ?, 'received', ?, ?, NULL, ?)",
                                   (identity, number, text, occurred_at, saved_observation, int(archive_only)))
            connection.execute("INSERT INTO incoming_inventory VALUES (?,?,?)", (content, ordinal, identity))
    connection.commit()


def receipt_operation(value):
    """Read receipts, look up one attempt without the modem, or acknowledge status."""
    connection = journal()
    try:
        if value == {"operation": "receipts"}:
            try:
                collect_incoming(connection, dbus.SystemBus())
            except Exception:
                # Outgoing journal sync does not depend on the modem being present.
                connection.rollback()
            rows = connection.execute("SELECT id,direction,number,text,status,occurred_at,archive_only FROM messages WHERE ack_status IS NULL OR ack_status != status ORDER BY last_offered,rowid LIMIT 4").fetchall()
            batch = []
            for row in rows:
                trial = batch + [dict(row)]
                # One maximum incoming body fits even at 6x JSON escaping.
                # Ordinary messages still drain four per handoff.
                if len(json.dumps({"receipts": trial}, ensure_ascii=False).encode()) > 2 * 1024 * 1024 - 16 * 1024:
                    break
                batch = trial
            if batch:
                turn = connection.execute("SELECT COALESCE(MAX(last_offered),0)+1 FROM messages").fetchone()[0]
                connection.executemany("UPDATE messages SET last_offered=? WHERE id=?", [(turn, row["id"]) for row in batch])
                connection.commit()
            print(json.dumps({"receipts": batch}, ensure_ascii=False))
        elif set(value) == {"operation", "message_id"} and value["operation"] == "lookup":
            if not isinstance(value["message_id"], str) or not ID_RE.fullmatch(value["message_id"]):
                raise ValueError("lookup")
            row = connection.execute("SELECT id,number,text,status FROM messages WHERE id=?", (value["message_id"],)).fetchone()
            print(json.dumps({"message": dict(row) if row else None}, ensure_ascii=False))
        elif set(value) == {"operation", "message_id", "status"} and value["operation"] == "ack":
            if not isinstance(value["message_id"], str) or not ID_RE.fullmatch(value["message_id"]) or value["status"] not in {"received", "sent", "not_sent", "unknown"}:
                raise ValueError("ack")
            connection.execute("UPDATE messages SET ack_status=? WHERE id=? AND status=?", (value["status"], value["message_id"], value["status"]))
            connection.commit()
            print('{"status":"accepted"}')
        else:
            raise ValueError("operation")
    finally:
        connection.close()


def main():
    """Validate stdin, serialize modem mutation, and emit one terminal result."""
    if os.geteuid() != 0 or len(sys.argv) != 1:
        _emit("not-sent:invalid-input")
        return 2
    signal.signal(signal.SIGALRM, _alarm)
    signal.alarm(3)
    try:
        raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
        value = json.loads(raw.decode("utf-8"))
        if isinstance(value, dict) and "operation" in value:
            signal.alarm(30)
            receipt_operation(value)
            return 0
        occurred_at = value.pop("occurred_at", None) if isinstance(value, dict) else None
        if occurred_at is not None:
            if not isinstance(occurred_at, str) or len(occurred_at) > 64:
                raise ValueError("timestamp")
            instant = datetime.fromisoformat(occurred_at)
            if instant.utcoffset() is None:
                raise ValueError("timestamp")
            occurred_at = instant.astimezone(timezone.utc).isoformat()
        message_id = value.pop("message_id", None) if isinstance(value, dict) else None
        if message_id is not None and (not isinstance(message_id, str) or not ID_RE.fullmatch(message_id)):
            raise ValueError("identity")
        number, text = parse_request(json.dumps(value).encode())
        message_id = message_id or uuid.uuid4().hex
    except InputTimeout:
        _emit("not-sent:input-timeout")
        return 2
    except (UnicodeError, ValueError, TypeError, OSError, sqlite3.Error):
        _emit("not-sent:invalid-input")
        return 2
    finally:
        signal.alarm(0)

    attempt = {"create": False}
    connection = None
    created = False
    try:
        signal.alarm(60)
        connection = journal()
        previous, created = begin_attempt(connection, message_id, number, text, occurred_at)
        if not created:
            connection.close()
            status = "sent" if previous == "sent" else "not-sent:dbus-unavailable" if previous == "not_sent" else "unknown:dbus-unavailable"
            _emit(status)
            return 0 if status == "sent" else 1
        lock_file = open(LOCK_PATH, "a+b")
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            status = "not-sent:busy"
        else:
            try:
                bus = dbus.SystemBus()
            except InputTimeout:
                raise
            except Exception:
                status = "not-sent:dbus-unavailable"
            else:
                status = send_sms(bus, number, text, attempt)
    except InputTimeout:
        status = ("unknown:time-limit" if attempt["create"]
                  else "not-sent:time-limit")
    except Exception:
        status = ("unknown:dbus-unavailable" if attempt["create"]
                  else "not-sent:dbus-unavailable")
    finally:
        signal.alarm(0)
    if connection is not None:
        try:
            if created:
                outcome = "sent" if status == "sent" else "not_sent" if status.startswith("not-sent:") else "unknown"
                connection.execute("UPDATE messages SET status=? WHERE id=? AND status='unknown'", (outcome, message_id))
                connection.commit()
        except Exception:
            # An effect may already have happened. Leave the pre-effect unknown.
            status = "unknown:dbus-unavailable"
        finally:
            connection.close()
    _emit(status)
    return 0 if status == "sent" else 1


if __name__ == "__main__":
    raise SystemExit(main())
