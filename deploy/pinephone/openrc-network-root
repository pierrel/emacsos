#!/bin/sh
# Fixed NetworkManager mutations for the unprivileged EmacsOS session.

set -eu
set -f
PATH=/usr/bin:/usr/sbin:/bin:/sbin
umask 077
ulimit -f 128
export PATH
export LC_ALL=C

lock=/run/emacsos-openrc-network.lock
output=
modem_restart_pending=0

fail() {
    printf '%s\n' "$1"
    exit 1
}

cleanup() {
    if [ "$modem_restart_pending" -eq 1 ]; then
        modem_restart_pending=0
        timeout -s TERM -k 2 15 /sbin/rc-service modemmanager start \
            9>&- >/dev/null 2>&1 || :
    fi
    [ -z "$output" ] || rm -f -- "$output"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

[ "$(id -u)" -eq 0 ] || fail 'not-connected:invalid-input'
[ "$#" -ge 1 ] || fail 'not-connected:invalid-input'
[ -x /usr/bin/nmcli ] || fail 'not-connected:unavailable'

touch "$lock"
chown root:root "$lock"
chmod 0600 "$lock"
exec 9>"$lock"
flock -n -x 9 || fail 'not-connected:busy'

run_nmcli() {
    [ -z "$output" ] || rm -f -- "$output"
    output=$(mktemp /run/emacsos-network.XXXXXX)
    if timeout -s TERM -k 1 20 /usr/bin/nmcli "$@" 9>&- >"$output" 2>&1; then
        return 0
    else
        status=$?
        case $status in 124|137) fail 'unknown:time-limit' ;; esac
        fail 'not-connected:failed'
    fi
}

probe_modem() {
    limit=$1
    grace=$2
    [ -z "$output" ] || rm -f -- "$output"
    output=$(mktemp /run/emacsos-modem.XXXXXX)
    if timeout -s TERM -k "$grace" "$limit" /usr/bin/mmcli -L \
        9>&- >"$output" 2>&1; then
        :
    else
        status=$?
        case $status in 124|137) return 3 ;; *) return 2 ;; esac
    fi
    if awk '
        BEGIN { valid = 1; found = 0 }
        /^[[:space:]]*\/org\/freedesktop\/ModemManager1\/Modem\/[0-9]+[[:space:]]+\[[^][]+\][[:space:]]+[^[:space:]][^[:cntrl:]]*$/ && $0 !~ /[^[:print:]]/ {
            found = 1
            next
        }
        { valid = 0 }
        END { exit (valid && found) ? 0 : 1 }
    ' "$output"; then
        return 0
    elif printf '%s\n' 'No modems were found' | cmp -s - "$output"; then
        return 1
    fi
    return 2
}

recover_modem() {
    [ -x /usr/bin/mmcli ] || fail 'not-connected:unavailable'
    if probe_modem 3 1; then
        return 0
    else
        status=$?
    fi
    case $status in
        1) ;;
        3) fail 'unknown:time-limit' ;;
        *) fail 'not-connected:failed' ;;
    esac
    [ -x /sbin/rc-service ] || fail 'not-connected:unavailable'
    [ -z "$output" ] || rm -f -- "$output"
    output=$(mktemp /run/emacsos-modem-restart.XXXXXX)
    modem_restart_pending=1
    if timeout -s TERM -k 2 30 /sbin/rc-service modemmanager restart \
        9>&- >"$output" 2>&1; then
        :
    else
        status=$?
        case $status in 124|137) fail 'unknown:time-limit' ;; esac
        fail 'not-connected:failed'
    fi
    attempt=0
    while [ "$attempt" -lt 10 ]; do
        if probe_modem 0.8 0.2; then
            return 0
        fi
        attempt=$((attempt + 1))
        [ "$attempt" -eq 10 ] || sleep 1
    done
    fail 'not-connected:failed'
}

validate_ssid() {
    ssid=$1
    [ -n "$ssid" ] && [ "${#ssid}" -le 32 ] || fail 'not-connected:invalid-input'
    printf '%s' "$ssid" 9>&- | timeout -s TERM -k 1 3 /usr/bin/python3 -I -c '
import sys

try:
    value = sys.stdin.buffer.read(33).decode("utf-8")
except UnicodeDecodeError:
    raise SystemExit(1)
if any(ord(character) < 32 or 127 <= ord(character) <= 159 or
       ord(character) in {0x061C, 0x200E, 0x200F} or
       0x202A <= ord(character) <= 0x202E or
       0x2066 <= ord(character) <= 0x2069 for character in value):
    raise SystemExit(1)
' 9>&- 2>/dev/null || fail 'not-connected:invalid-input'
}

validate_uuid() {
    uuid=$1
    old_ifs=$IFS
    IFS=-
    set -- $uuid
    IFS=$old_ifs
    [ "$#" -eq 5 ] &&
        [ "${#1}" -eq 8 ] && [ "${#2}" -eq 4 ] &&
        [ "${#3}" -eq 4 ] && [ "${#4}" -eq 4 ] &&
        [ "${#5}" -eq 12 ] || fail 'not-connected:invalid-input'
    case $1$2$3$4$5 in
        *[!0-9A-Fa-f]*) fail 'not-connected:invalid-input' ;;
    esac
}

operation=$1
shift
case $operation in
    wifi)
        [ "$#" -eq 1 ] || fail 'not-connected:invalid-input'
        case $1 in on|off) ;; *) fail 'not-connected:invalid-input' ;; esac
        run_nmcli radio wifi "$1"
        ;;
    cell)
        [ "$#" -eq 1 ] || fail 'not-connected:invalid-input'
        case $1 in up|down) ;; *) fail 'not-connected:invalid-input' ;; esac
        [ "$1" = down ] || recover_modem
        run_nmcli con "$1" emacsos-cellular
        modem_restart_pending=0
        ;;
    saved)
        [ "$#" -eq 1 ] || fail 'not-connected:invalid-input'
        validate_uuid "$1"
        run_nmcli -g connection.type con show uuid "$1"
        [ "$(sed -n '1p' "$output")" = 802-11-wireless ] &&
            [ "$(wc -l <"$output")" -eq 1 ] ||
            fail 'not-connected:failed'
        run_nmcli con up uuid "$1"
        printf '%s\n' connected
        ;;
    open)
        [ "$#" -eq 1 ] || fail 'not-connected:invalid-input'
        validate_ssid "$1"
        run_nmcli dev wifi connect "$1"
        printf '%s\n' connected
        ;;
    *) fail 'not-connected:invalid-input' ;;
esac
