# Template for the sms-forward systemd unit — the phone's SMS<->assist bridge.
# Runs ON THE PHONE (where the modem is). Installed by `make deploy-sms-forward`, which
# scp's the single stdlib script + this unit + an env file to the phone (no repo/venv there).
# Placeholders (@@...@@) are filled at deploy time so no operator-specific value lands here.
[Unit]
Description=sms-forward (modem SMS <-> assist inbound/outbound)
After=network-online.target ModemManager.service
Wants=network-online.target ModemManager.service

[Service]
Type=exec
User=@@USER@@
# ASSIST_SMS_SECRET + ASSIST_SMS_INBOUND_URL + ASSIST_SMS_FORWARD_PORT (0600, not in the repo).
EnvironmentFile=@@ENV_FILE@@
ExecStart=/usr/bin/python3 @@SCRIPT_PATH@@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
