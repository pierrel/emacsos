# Free the SIM7600 secondary AT port (ttyUSB3, USB interface 03) from
# ModemManager so emacsos can drive raw-AT voice/audio on it: ATA to answer
# (ModemManager's QMI accept is broken on this modem -- "InvalidQosId"),
# AT+CHUP, and later AT+CSDVC / AT+CPCMREG for call audio.
#
# ModemManager KEEPS the QMI control port (cdc-wdm0), GPS (ttyUSB1), and the
# PRIMARY AT port (ttyUSB2), so call DETECTION (Voice.CallAdded D-Bus signal)
# and the data bearer are unaffected. Only the secondary AT port is handed off.
#
# See docs/2026-06-18-inbound-answering.org. Install via `make install-modem-at-port`.
ACTION=="add|change|bind", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1e0e", ENV{ID_MODEL_ID}=="9001", ENV{ID_USB_INTERFACE_NUM}=="03", ENV{ID_MM_PORT_IGNORE}="1"
